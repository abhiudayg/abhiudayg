---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import MermaidLoader from '../components/MermaidLoader.astro';
import PartTag from '../components/PartTag.astro';
import { BLOG_SERIES } from '../consts';
import { getReadingTime } from '../utils/blog';
import {
	absoluteUrl,
	blogPostJsonLd,
	breadcrumbJsonLd,
	graphJsonLd,
	resolveImageUrl,
} from '../utils/seo';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, series, seriesPart, heroImage, tags = [] } = post.data;
const slug = post.id;
const seriesMeta = series ? BLOG_SERIES[series] : null;
const postUrl = absoluteUrl(`/blog/${slug}/`, Astro.site);
const imageUrl = resolveImageUrl(heroImage, Astro.site);
const allTags = Array.from(new Set([...(series ? [series, ...(seriesMeta ? [seriesMeta.title] : [])] : []), ...tags]));
const readTime = getReadingTime(post.body);

const breadcrumbItems = [
	{ name: 'Home', url: absoluteUrl('/', Astro.site) },
	{ name: 'Blog', url: absoluteUrl('/blog/', Astro.site) },
	...(seriesMeta
		? [{ name: seriesMeta.title, url: absoluteUrl(`/blog/series/${series}/`, Astro.site) }]
		: []),
	{ name: title, url: postUrl },
];
const schema = graphJsonLd(
	blogPostJsonLd({
		title,
		description,
		url: postUrl,
		image: imageUrl,
		pubDate,
		updatedDate,
		series,
		tags: allTags,
	}),
	breadcrumbJsonLd(breadcrumbItems),
);
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage ?? '/og-default.jpg'}
			type="article"
			publishedTime={pubDate}
			modifiedTime={updatedDate ?? pubDate}
			section={seriesMeta?.title}
			tags={allTags}
		/>
		<JsonLd schema={schema} />
	</head>

	<body class="relative min-h-screen bg-bg text-text antialiased selection:bg-surface-card selection:text-accent">
		<!-- Top Reading Progress Indicator -->
		<div id="reading-progress" aria-hidden="true"></div>

		<!-- Framer-Style Animated Moving Gradient Grid Background -->
		<div class="framer-grid-container" aria-hidden="true" id="framer-bg">
			<div class="framer-orb-1"></div>
			<div class="framer-orb-2"></div>
			<div class="framer-spotlight" id="framer-spotlight"></div>
			<div class="framer-grid-overlay"></div>
		</div>

		<Header />

		<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 animate-fade-in">
			<article itemscope itemtype="https://schema.org/BlogPosting" class="space-y-8">
				<meta itemprop="headline" content={title} />
				<meta itemprop="description" content={description} />
				<meta itemprop="datePublished" content={pubDate.toISOString()} />
				<meta itemprop="dateModified" content={(updatedDate ?? pubDate).toISOString()} />
				<link itemprop="url" href={postUrl} />
				<link itemprop="image" href={imageUrl} />

				<!-- Back Button & Breadcrumb Navigation (Anode Style) -->
				<div class="flex items-center justify-between pb-6 border-b border-white/[0.08]">
					<a
						href="/blog"
						class="inline-flex items-center gap-1.5 text-xs font-mono text-white hover:text-white transition-colors py-1.5 px-3 rounded-lg bg-white/[0.04] border border-white/[0.1] hover:bg-white/[0.08] no-underline"
					>
						<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<polyline points="15 18 9 12 15 6"></polyline>
						</svg>
						<span>Back to Journal</span>
					</a>

					<div class="flex items-center gap-2">
						{seriesMeta && (
							<a
								href={`/blog/series/${series}/`}
								class="px-2.5 py-0.5 rounded-full bg-white/[0.04] text-white border border-white/[0.1] font-semibold text-xs font-mono no-underline hover:bg-white/[0.08] transition-colors"
							>
								#{seriesMeta.title}
							</a>
						)}
						{seriesPart && <PartTag part={seriesPart} />}
					</div>
				</div>

				<!-- Article Header (Anode Style) -->
				<div class="space-y-4 pt-2">
					<div class="flex flex-wrap items-center gap-3 text-xs text-neutral-400 font-mono">
						{seriesMeta && (
							<>
								<span class="px-2.5 py-0.5 rounded-full bg-white/[0.04] text-white border border-white/[0.1] font-semibold">
									{seriesMeta.title}
								</span>
								<span>&bull;</span>
							</>
						)}
						<span class="flex items-center gap-1.5">
							<svg class="w-3.5 h-3.5 text-neutral-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
								<line x1="16" y1="2" x2="16" y2="6" />
								<line x1="8" y1="2" x2="8" y2="6" />
								<line x1="3" y1="10" x2="21" y2="10" />
							</svg>
							<FormattedDate date={pubDate} />
						</span>
						{updatedDate && (
							<>
								<span>&bull;</span>
								<span class="text-neutral-500 italic">
									updated <FormattedDate date={updatedDate} />
								</span>
							</>
						)}
						<span>&bull;</span>
						<span class="flex items-center gap-1.5">
							<svg class="w-3.5 h-3.5 text-neutral-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="12" cy="12" r="10" />
								<polyline points="12 6 12 12 16 14" />
							</svg>
							{readTime}
						</span>
					</div>

					<h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight" itemprop="name">
						{title}
					</h1>

					<p class="text-base sm:text-lg text-neutral-400 leading-relaxed font-sans">
						{description}
					</p>

					<!-- Author Chip (Anode Style) -->
					<div class="flex items-center gap-3 pt-2">
						<div class="w-9 h-9 rounded-full bg-white/[0.08] border border-white/[0.12] flex items-center justify-center text-white font-bold text-xs font-mono">
							A
						</div>
						<div>
							<div class="text-sm font-semibold text-white">Abhiuday Gupta</div>
							<div class="text-xs text-neutral-500 font-mono">Systems &amp; AI Engineer &bull; Bengaluru</div>
						</div>
					</div>

					<!-- Series Track Card -->
					{seriesMeta && (
						<div class="p-4 rounded-xl border border-white/[0.08] bg-[#0a0a0c] text-xs font-mono flex flex-col sm:flex-row sm:items-center justify-between gap-3 my-4">
							<div class="flex items-center gap-2">
								<span class="text-emerald-400 font-semibold">Track:</span>
								<span class="text-neutral-300">
									Part of the <a class="text-white font-semibold underline underline-offset-4 decoration-white/30 hover:decoration-white" href={`/blog/series/${series}/`}>{seriesMeta.title}</a> series ({seriesMeta.badge})
								</span>
							</div>
							{seriesMeta.repoUrl && (
								<a
									class="text-neutral-400 hover:text-white no-underline inline-flex items-center gap-1 shrink-0"
									href={seriesMeta.repoUrl}
									target="_blank"
									rel="noopener noreferrer"
								>
									<span>Source code</span>
									<span aria-hidden="true">&nearr;</span>
								</a>
							)}
						</div>
					)}
				</div>

				<!-- Article Body -->
				<div class="prose-content pt-4" itemprop="articleBody">
					<slot />
				</div>

				<!-- Topics / Tags -->
				{allTags.length > 0 && (
					<div class="mt-12 pt-6 border-t border-white/[0.08] flex flex-wrap items-center gap-2">
						<span class="font-mono text-xs text-neutral-500">Topics:</span>
						{allTags.map((tag) => (
							<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono bg-white/[0.03] border border-white/[0.08] text-neutral-400">
								#{tag}
							</span>
						))}
					</div>
				)}

				<!-- End of Article CTA Box (Anode Style with user's verified channels) -->
				<div class="p-8 rounded-2xl bg-[#0a0a0c] border border-white/[0.12] mt-12 space-y-4">
					<h3 class="text-lg font-bold text-white flex items-center gap-2">
						<svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<polyline points="4 17 10 11 4 5" />
							<line x1="12" y1="19" x2="20" y2="19" />
						</svg>
						<span>Follow Systems &amp; Runtimes Architecture</span>
					</h3>
					<p class="text-xs sm:text-sm text-neutral-400 leading-relaxed">
						Explaining systems engineering without cloud bloat. Excalidraw &bull; Terminals &bull; Bare Metal.
					</p>
					<div class="flex flex-wrap items-center gap-3 pt-1">
						<a
							href="https://x.com/abhiudayg"
							target="_blank"
							rel="noopener noreferrer"
							class="px-4 py-2 rounded-lg bg-white hover:bg-neutral-200 text-black font-semibold text-xs font-mono transition-colors no-underline inline-flex items-center gap-1.5"
						>
							<span>Follow on X</span>
							<span aria-hidden="true">&nearr;</span>
						</a>
						<a
							href="https://www.instagram.com/baremetal.dev/"
							target="_blank"
							rel="noopener noreferrer"
							class="px-4 py-2 rounded-lg bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.1] text-xs font-mono text-white transition-colors no-underline inline-flex items-center gap-1.5"
						>
							<span>@baremetal.dev (Instagram)</span>
							<span aria-hidden="true">&nearr;</span>
						</a>
						<a
							href="https://www.linkedin.com/in/abhiudayg/"
							target="_blank"
							rel="noopener noreferrer"
							class="px-4 py-2 rounded-lg bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.1] text-xs font-mono text-white transition-colors no-underline inline-flex items-center gap-1.5"
						>
							<span>LinkedIn</span>
							<span aria-hidden="true">&nearr;</span>
						</a>
						<a
							href="https://github.com/abhiudayg"
							target="_blank"
							rel="noopener noreferrer"
							class="px-4 py-2 rounded-lg bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.1] text-xs font-mono text-white transition-colors no-underline inline-flex items-center gap-1.5"
						>
							<span>GitHub</span>
							<span aria-hidden="true">&nearr;</span>
						</a>
					</div>
				</div>
			</article>
		</main>

		<Footer />
		<MermaidLoader />

		<script is:inline>
			function setupBlogPost() {
				// 1. Reading progress indicator
				const progress = document.getElementById('reading-progress');
				function updateProgress() {
					if (!progress) return;
					const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
					if (totalHeight <= 0) {
						progress.style.width = '0%';
						return;
					}
					const percent = Math.min(100, Math.max(0, (window.scrollY / totalHeight) * 100));
					progress.style.width = `${percent}%`;
				}
				window.addEventListener('scroll', updateProgress, { passive: true });
				updateProgress();

				// 2. 1-Click Code Copy Injection
				document.querySelectorAll('.prose-content pre').forEach((pre) => {
					if (pre.querySelector('.copy-code-btn')) return;
					pre.style.position = 'relative';
					const btn = document.createElement('button');
					btn.className = 'copy-code-btn';
					btn.setAttribute('aria-label', 'Copy code snippet');
					btn.innerHTML = `<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`;
					btn.onclick = async () => {
						const code = pre.querySelector('code')?.innerText || pre.innerText;
						try {
							await navigator.clipboard.writeText(code);
						} catch {
							const textarea = document.createElement('textarea');
							textarea.value = code;
							document.body.appendChild(textarea);
							textarea.select();
							document.execCommand('copy');
							document.body.removeChild(textarea);
						}
						btn.innerHTML = `<span class="text-[10px] font-mono text-emerald-400">✓</span>`;
						setTimeout(() => {
							btn.innerHTML = `<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`;
						}, 2000);
					};
					pre.appendChild(btn);
				});

				// 3. Spotlight tracking
				const bg = document.getElementById('framer-bg');
				if (bg) {
					document.addEventListener('pointermove', (e) => {
						bg.style.setProperty('--mouse-x', `${e.clientX}px`);
						bg.style.setProperty('--mouse-y', `${e.clientY}px`);
					});
				}
			}

			setupBlogPost();
			document.addEventListener('astro:page-load', setupBlogPost);
		</script>
	</body>
</html>
