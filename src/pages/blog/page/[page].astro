---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import JsonLd from '../../../components/JsonLd.astro';
import Pagination from '../../../components/Pagination.astro';
import PostCard from '../../../components/PostCard.astro';
import SeriesFilter from '../../../components/SeriesFilter.astro';
import { BLOG_SERIES, POSTS_PER_PAGE, SITE_TITLE } from '../../../consts';
import { getExtraPaginationPages, getSortedPosts, paginatePosts } from '../../../utils/blog';
import { absoluteUrl, breadcrumbJsonLd, collectionPageJsonLd, graphJsonLd } from '../../../utils/seo';

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	return getExtraPaginationPages(posts.length, POSTS_PER_PAGE).map((page) => ({
		params: { page: String(page) },
	}));
}

const page = Number(Astro.params.page);
if (!Number.isInteger(page) || page < 2) {
	return Astro.redirect('/blog/');
}

const posts = await getSortedPosts();
const pagination = paginatePosts(posts, page, POSTS_PER_PAGE);

if (pagination.currentPage !== page) {
	return Astro.redirect('/blog/');
}

const description = `Older posts from the ${SITE_TITLE} archive — page ${pagination.currentPage} of ${pagination.totalPages}.`;
const pageUrl = absoluteUrl(`/blog/page/${pagination.currentPage}/`, Astro.site);
const schema = graphJsonLd(
	collectionPageJsonLd({
		name: `Blog — Page ${pagination.currentPage}`,
		description,
		url: pageUrl,
	}),
	breadcrumbJsonLd([
		{ name: 'Home', url: absoluteUrl('/', Astro.site) },
		{ name: 'Blog', url: absoluteUrl('/blog/', Astro.site) },
		{ name: `Page ${pagination.currentPage}`, url: pageUrl },
	]),
);
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead
			title={`Blog — page ${pagination.currentPage}`}
			description={description}
			canonicalPath={`/blog/page/${pagination.currentPage}/`}
		/>
		<JsonLd schema={schema} />
		{
			pagination.currentPage > 1 && (
				<link rel="prev" href={pagination.currentPage === 2 ? '/blog/' : `/blog/page/${pagination.currentPage - 1}/`} />
			)
		}
		{
			pagination.currentPage < pagination.totalPages && (
				<link rel="next" href={`/blog/page/${pagination.currentPage + 1}/`} />
			)
		}
	</head>
	<body class="relative min-h-screen bg-bg text-text antialiased selection:bg-surface-card selection:text-accent">
		<!-- Framer-Style Animated Moving Gradient Grid Background -->
		<div class="framer-grid-container" aria-hidden="true" id="framer-bg">
			<div class="framer-orb-1"></div>
			<div class="framer-orb-2"></div>
			<div class="framer-spotlight" id="framer-spotlight"></div>
			<div class="framer-grid-overlay"></div>
		</div>

		<Header />

		<main class="shell relative py-12 sm:py-16 md:py-20 space-y-12 animate-fade-in">
			<header class="border-b border-border pb-10 space-y-4">
				<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-card border border-border font-mono text-xs text-text-muted">
					<span class="w-1.5 h-1.5 rounded-full bg-status-emerald animate-pulse"></span>
					<span>Archive &bull; Page {pagination.currentPage} of {pagination.totalPages}</span>
				</div>
				<h1 class="text-3xl sm:text-5xl font-sans font-semibold tracking-[-0.035em] text-text leading-[1.15]">
					Technical Essays &amp; Archive
				</h1>
				<p class="text-base sm:text-lg text-text-muted leading-relaxed max-w-3xl">
					{description}
				</p>
			</header>

			<SeriesFilter />

			<ul class="post-grid">
				{pagination.items.map((post) => <PostCard post={post} />)}
			</ul>

			<Pagination
				currentPage={pagination.currentPage}
				totalPages={pagination.totalPages}
				basePath="/blog"
			/>
		</main>

		<Footer />

		<script is:inline>
			function initSpotlight() {
				const bg = document.getElementById('framer-bg');
				if (!bg) return;
				document.addEventListener('pointermove', (e) => {
					bg.style.setProperty('--mouse-x', `${e.clientX}px`);
					bg.style.setProperty('--mouse-y', `${e.clientY}px`);
				});
			}
			initSpotlight();
			document.addEventListener('astro:page-load', initSpotlight);
		</script>
	</body>
</html>
