---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import JsonLd from '../../components/JsonLd.astro';
import PostCard from '../../components/PostCard.astro';
import SeriesFilter from '../../components/SeriesFilter.astro';
import { BLOG_SERIES } from '../../consts';
import { getSortedPosts } from '../../utils/blog';
import { absoluteUrl, blogJsonLd, breadcrumbJsonLd, graphJsonLd } from '../../utils/seo';

const posts = await getSortedPosts();
const totalTracks = Object.keys(BLOG_SERIES).length;
const description =
	'Deep architectural breakdowns into autonomous agent runtimes, local MCP routing under token budgets, Linux kernel socket splicing, and bare-metal orchestration.';
const schema = graphJsonLd(
	blogJsonLd(Astro.site),
	breadcrumbJsonLd([
		{ name: 'Home', url: absoluteUrl('/', Astro.site) },
		{ name: 'Blog', url: absoluteUrl('/blog/', Astro.site) },
	]),
);
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead title="Technical Journal & Essays — Systems & Architecture" description={description} />
		<JsonLd schema={schema} />
	</head>
	<body class="relative min-h-screen bg-bg text-text antialiased selection:bg-surface-card selection:text-accent">
		<!-- Framer-Style Animated Moving Gradient Grid Background -->
		<div class="framer-grid-container" aria-hidden="true" id="framer-bg">
			<div class="framer-orb-1"></div>
			<div class="framer-orb-2"></div>
			<div class="framer-spotlight" id="framer-spotlight"></div>
			<div class="framer-grid-overlay"></div>
		</div>

		<Header />

		<main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-28 pb-20 space-y-10 animate-fade-in">
			<!-- Centered Header (Anode Technical Journal Style) -->
			<header class="text-center max-w-2xl mx-auto space-y-4">
				<span class="text-xs font-mono uppercase tracking-wider text-white bg-white/[0.04] border border-white/[0.1] px-3.5 py-1 rounded-full inline-block font-semibold">
					// ENGINEERING &amp; SYSTEMS RESEARCH
				</span>
				<h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
					Technical Journal &amp; Essays
				</h1>
				<p class="text-sm sm:text-base text-neutral-400 leading-relaxed">
					{description}
				</p>
			</header>

			<!-- Single Unified Filter Rail (Anode Centered Pills Style) -->
			<SeriesFilter />

			<!-- All Post Cards in Stacked Layout (Anode Style) -->
			<ul id="blog-posts-grid" class="space-y-6 list-none p-0 m-0">
				{posts.map((post) => <PostCard post={post} />)}
			</ul>

			<!-- Infinite Scroll Sentinel & Status Block -->
			<div id="infinite-scroll-sentinel" class="py-10 flex flex-col items-center justify-center space-y-3">
				<div id="infinite-loader" class="hidden items-center gap-2 font-mono text-xs text-neutral-400">
					<span class="w-1.5 h-1.5 rounded-full bg-status-emerald animate-pulse"></span>
					<span>Loading more dispatches...</span>
				</div>

				<div id="infinite-end" class="font-mono text-xs text-neutral-500 text-center py-4 border-t border-white/[0.06] w-full max-w-md mx-auto">
					<span>// End of dispatches. 100% full-text RSS available.</span>
				</div>

				<div id="infinite-empty" class="hidden p-8 rounded-2xl border border-white/[0.08] bg-[#0a0a0c]/90 text-center space-y-3 w-full max-w-md mx-auto">
					<p class="font-mono text-xs text-neutral-400">No essays match the selected filter.</p>
					<button type="button" id="empty-clear-btn" class="px-3.5 py-1.5 rounded-lg bg-white/[0.04] border border-white/[0.1] hover:bg-white/[0.08] text-xs font-mono text-white transition-colors cursor-pointer">
						Reset Filter &rarr;
					</button>
				</div>
			</div>
		</main>

		<Footer />

		<script is:inline>
			function setupInfiniteScrollAndFilter() {
				const grid = document.getElementById('blog-posts-grid');
				const sentinel = document.getElementById('infinite-scroll-sentinel');
				const loader = document.getElementById('infinite-loader');
				const endMsg = document.getElementById('infinite-end');
				const emptyMsg = document.getElementById('infinite-empty');
				const emptyClearBtn = document.getElementById('empty-clear-btn');
				const matchCount = document.getElementById('filter-match-count');

				if (!grid || !sentinel) return;

				const allCards = Array.from(grid.querySelectorAll('.post-item'));
				const BATCH_SIZE = 4;
				let activeSeries = '';
				let activeTag = '';
				let visibleLimit = BATCH_SIZE;

				function getMatchingCards() {
					return allCards.filter((card) => {
						const series = card.getAttribute('data-series') || '';
						const tags = card.getAttribute('data-tags') || '';

						if (activeSeries && series !== activeSeries) return false;
						if (activeTag && !tags.includes(activeTag.toLowerCase())) return false;
						return true;
					});
				}

				function renderFeed() {
					const matching = getMatchingCards();

					// Update match count badge
					if (matchCount) {
						if (!activeSeries && !activeTag) {
							matchCount.textContent = `All ${allCards.length} technical essays`;
						} else {
							matchCount.textContent = `Showing ${matching.length} of ${allCards.length} technical essays`;
						}
					}

					// Hide all cards first
					allCards.forEach((c) => c.classList.add('hidden'));

					if (matching.length === 0) {
						if (emptyMsg) emptyMsg.classList.remove('hidden');
						if (endMsg) endMsg.classList.add('hidden');
						if (loader) loader.classList.add('hidden');
						return;
					}

					if (emptyMsg) emptyMsg.classList.add('hidden');

					// Reveal matching cards up to visibleLimit
					const toShow = matching.slice(0, visibleLimit);
					toShow.forEach((card) => {
						card.classList.remove('hidden');
					});

					// Update sentinel states
					if (visibleLimit >= matching.length) {
						if (loader) loader.classList.add('hidden');
						if (endMsg) endMsg.classList.remove('hidden');
					} else {
						if (endMsg) endMsg.classList.add('hidden');
						if (loader) loader.classList.remove('hidden');
					}
				}

				// Intersection Observer for Infinite Scroll
				const observer = new IntersectionObserver(
					(entries) => {
						const entry = entries[0];
						if (!entry || !entry.isIntersecting) return;

						const matching = getMatchingCards();
						if (visibleLimit < matching.length) {
							// Trigger progressive load
							if (loader) loader.classList.remove('hidden');
							setTimeout(() => {
								visibleLimit += BATCH_SIZE;
								renderFeed();
							}, 200);
						}
					},
					{ rootMargin: '200px' }
				);

				observer.observe(sentinel);

				// Listen for filter changes from SeriesFilter
				window.addEventListener('blog-filter-change', (e) => {
					activeSeries = e.detail?.series || '';
					activeTag = e.detail?.tag || '';
					visibleLimit = BATCH_SIZE;
					renderFeed();
				});

				if (emptyClearBtn) {
					emptyClearBtn.onclick = () => {
						window.dispatchEvent(
							new CustomEvent('blog-filter-change', {
								detail: { series: '', tag: '' },
							})
						);
					};
				}

				// Initial render
				renderFeed();

				// Spotlight tracking
				const bg = document.getElementById('framer-bg');
				if (bg) {
					document.addEventListener('pointermove', (e) => {
						bg.style.setProperty('--mouse-x', `${e.clientX}px`);
						bg.style.setProperty('--mouse-y', `${e.clientY}px`);
					});
				}
			}

			setupInfiniteScrollAndFilter();
			document.addEventListener('astro:page-load', setupInfiniteScrollAndFilter);
		</script>
	</body>
</html>
