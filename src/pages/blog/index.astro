---
import Analytics from '@vercel/analytics/astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import JsonLd from '../../components/JsonLd.astro';
import Pagination from '../../components/Pagination.astro';
import PostCard from '../../components/PostCard.astro';
import SeriesFilter from '../../components/SeriesFilter.astro';
import { POSTS_PER_PAGE } from '../../consts';
import { getSortedPosts, paginatePosts } from '../../utils/blog';
import { absoluteUrl, blogJsonLd, breadcrumbJsonLd, graphJsonLd } from '../../utils/seo';

const posts = await getSortedPosts();
const pagination = paginatePosts(posts, 1, POSTS_PER_PAGE);
const description =
	'In-depth technical essays on autonomous agent runtimes, local MCP routing under token budgets, distributed systems architecture, and engineering post-mortems.';
const schema = graphJsonLd(
	blogJsonLd(Astro.site),
	breadcrumbJsonLd([
		{ name: 'Home', url: absoluteUrl('/', Astro.site) },
		{ name: 'Blog', url: absoluteUrl('/blog/', Astro.site) },
	]),
);
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead title="Technical Essays & Architecture Dispatches" description={description} />
		<JsonLd schema={schema} />
		<Analytics />
		{
			pagination.totalPages > 1 && (
				<link rel="next" href="/blog/page/2/" />
			)
		}
	</head>
	<body class="relative min-h-screen bg-bg text-text antialiased selection:bg-surface-card selection:text-accent">
		<!-- Subdued ambient dark radial halo -->
		<div
			class="pointer-events-none fixed top-0 left-1/2 -z-10 h-[500px] w-[950px] -translate-x-1/2 rounded-full ambient-glow blur-[120px]"
			aria-hidden="true"
		></div>

		<Header />
		<main class="shell py-12 md:py-16 space-y-10">
			<header class="border-b border-border pb-8">
				<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-card border border-border font-mono text-xs text-text-muted mb-4">
					<span class="w-1.5 h-1.5 rounded-full bg-status-emerald"></span>
					<span>Dispatches &bull; Engineering Journal</span>
				</div>
				<h1 class="text-3xl sm:text-4xl md:text-5xl font-sans font-semibold tracking-tight text-text">
					Technical Essays &amp; Archive
				</h1>
				<p class="mt-3 text-base sm:text-lg text-text-muted leading-relaxed max-w-3xl">
					{description}
				</p>
			</header>

			<SeriesFilter />

			<ul class="post-grid">
				{pagination.items.map((post) => <PostCard post={post} />)}
			</ul>

			<Pagination
				currentPage={pagination.currentPage}
				totalPages={pagination.totalPages}
				basePath="/blog"
			/>
		</main>
		<Footer />
	</body>
</html>
