					<!-- Bento Card 3: shipnote (Col 12 md:6) -->
					<div class="system-card md:col-span-6 bg-surface-card border border-border rounded-xl p-6 md:p-8 bento-card-glow flex flex-col justify-between space-y-6" data-category="tools systems">
