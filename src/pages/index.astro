							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z"></path>
						</svg>
						<span>RSS Feed</span>
					</a>
				</div>

				<!-- BareMetal.dev Channel Spotlight Banner -->
				<div class="rounded-xl border border-border bg-surface-card p-4 sm:p-5 bento-card-glow relative overflow-hidden">
					<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
						<div class="space-y-1">
							<div class="flex items-center gap-2">
								<span class="live-beacon"></span>
								<span class="font-mono text-xs font-semibold text-status-emerald">@baremetal.dev</span>
								<span class="text-text-dim">&bull;</span>
								<span class="font-mono text-xs text-text-muted">Systems Engineering Without Cloud Bloat</span>
							</div>
							<p class="text-xs sm:text-sm text-text-muted m-0 font-sans">
								Excalidraw &bull; Terminals &bull; Bare Metal. High-signal visual deep-dives into kernel primitives, Go runtime internals, and local systems.
							</p>
							<div class="flex items-center gap-2.5 font-mono text-[11px] text-text-dim pt-0.5">
								<span>📍 Bengaluru</span>
								<span>&bull;</span>
								<span class="text-status-emerald">Deep-dives below 👇</span>
							</div>
						</div>

						<a
							class="btn-primary shrink-0 self-start sm:self-center font-mono text-xs no-underline flex items-center gap-2"
							href={INSTAGRAM_URL}
							target="_blank"
							rel="noopener noreferrer"
						>
							<span>Watch Deep Dives</span>
							<span aria-hidden="true">&nearr;</span>
						</a>
					</div>
				</div>

				<!-- Resend-Style Capability Pills (Replaces fake vanity stats with authentic badges) -->
				<div class="flex flex-wrap items-center gap-2 pt-6 border-t border-border font-mono text-xs text-text-dim">
					<span class="tag-pill text-text">Bare-Metal Go Orchestration</span>
					<span class="text-border-hover">&bull;</span>
					<span class="tag-pill text-text">Autonomous Agent Runtimes</span>
					<span class="text-border-hover">&bull;</span>
					<span class="tag-pill text-text">Local MCP Routing</span>
					<span class="text-border-hover">&bull;</span>
					<span class="tag-pill text-text">Linux Kernel Primitives</span>
					<span class="text-border-hover">&bull;</span>
					<span class="tag-pill text-text">100% Zero-Tracker RSS</span>
				</div>
			</section>

			<!-- 2. Featured Systems Bento Grid with GitHub Icons & Live Interactive DAG -->
			<section class="space-y-6 scroll-mt-20" id="systems">
				<div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-border pb-4 gap-3">
					<div>
						<span class="font-mono text-xs text-text-dim uppercase tracking-wider">// Engineered Artifacts</span>
						<h2 class="text-2xl sm:text-3xl font-semibold text-text mt-1 tracking-tight">Featured Systems &amp; Runtimes</h2>
					</div>

					<!-- Interactive Category Filter Tabs -->
					<div class="flex items-center gap-1.5 font-mono text-xs overflow-x-auto pb-1 sm:pb-0" id="system-filter-tabs">
