										id="node-dispatcher"
									>
										Tool Dispatcher
									</button>
								</div>
							</div>

							<!-- Live Telemetry Terminal -->
							<div class="p-2.5 rounded bg-bg border border-border text-[11px] font-mono text-text-dim space-y-1" id="dag-stage-info">
								<div class="flex justify-between text-text">
									<span class="text-status-emerald font-semibold">Active Stage: Intent Planner</span>
									<span class="text-text-dim">IPC: zero-copy active</span>
								</div>
								<div class="text-text-muted">
									Breakdown: decompose goal into acyclic task graphs &bull; mean latency: 120&mu;s &bull; memory: zero-alloc
								</div>
							</div>
						</div>

						<!-- Tags & Action -->
						<div class="flex flex-wrap items-center gap-2 pt-2 border-t border-border font-mono text-xs">
							<span class="tag-pill">Rust</span>
							<span class="tag-pill">Tokio</span>
							<span class="tag-pill">gRPC</span>
							<span class="tag-pill">SQLite WAL</span>
							<a class="ml-auto text-text-dim hover:text-text no-underline flex items-center gap-1" href="/blog/series/agent-brain/">
								<span>Read series breakdown</span>
								<span aria-hidden="true">&rarr;</span>
							</a>
						</div>
					</div>

					<!-- Bento Card 2: dustmap (Col 12 md:4) -->
					<div class="system-card md:col-span-4 bg-surface-card border border-border rounded-xl p-6 bento-card-glow flex flex-col justify-between space-y-5" data-category="systems">
						<div class="space-y-3">
							<div class="flex items-center justify-between">
								<div class="flex items-center gap-2">
									<span class="w-2 h-2 rounded-full bg-status-emerald"></span>
									<h3 class="text-lg font-semibold text-text tracking-tight">dustmap</h3>
								</div>
								
								<a
									class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-bg-subtle border border-border text-text-muted hover:text-text transition-colors font-mono text-xs no-underline"
									href="https://github.com/abhiudayg/dustmap"
									target="_blank"
									rel="noopener noreferrer"
									aria-label="View dustmap on GitHub"
								>
									<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
