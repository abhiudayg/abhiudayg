							</div>
						</div>

						<div class="flex flex-wrap items-center gap-2 pt-2 border-t border-border font-mono text-xs">
							<span class="tag-pill">Rust</span>
							<span class="tag-pill">Tauri</span>
							<a class="ml-auto text-text-dim hover:text-text no-underline" href="/blog/series/dustmap/">
								Series &rarr;
							</a>
						</div>
					</div>

					<!-- Bento Card 3: agentrun (Col 12 md:4) -->
					<div class="system-card md:col-span-4 bg-surface-card border border-border rounded-xl p-6 bento-card-glow flex flex-col justify-between space-y-4" data-category="ai systems">
						<div class="space-y-2">
							<div class="flex items-center justify-between">
								<h3 class="text-base font-semibold text-text tracking-tight">agentrun</h3>
								
								<a
									class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-bg-subtle border border-border text-text-muted hover:text-text transition-colors font-mono text-xs no-underline"
									href="https://github.com/autonomic-ai-dev/agentrun"
									target="_blank"
