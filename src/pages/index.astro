---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import { BLOG_SERIES, GITHUB_URL, RSS_FEED_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getSortedPosts } from '../utils/blog';
import { graphJsonLd, websiteJsonLd } from '../utils/seo';

const allPosts = await getSortedPosts();
const schema = graphJsonLd(websiteJsonLd(Astro.site));

const seriesList = Object.entries(BLOG_SERIES).map(([slug, meta]) => ({
	slug,
	...meta,
	count: allPosts.filter((p) => p.data.series === slug).length,
}));
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<JsonLd schema={schema} />
	</head>
	<body class="relative min-h-screen bg-bg text-text antialiased selection:bg-surface-card selection:text-accent">
		<!-- Framer-Style Animated Moving Gradient Grid Background -->
		<div class="framer-grid-container" aria-hidden="true" id="framer-bg">
			<div class="framer-orb-1"></div>
			<div class="framer-orb-2"></div>
			<div class="framer-spotlight" id="framer-spotlight"></div>
			<div class="framer-grid-overlay"></div>
		</div>

		<Header />

		<main class="shell py-10 sm:py-16 md:py-20 space-y-20 md:space-y-28">
			<!-- 1. Hero Section -->
			<section class="relative space-y-6 sm:space-y-8 max-w-4xl">
				<!-- Status Badge / Pill (Resend style) -->
				<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-card border border-border font-mono text-[11px] sm:text-xs text-text-muted">
					<span class="w-1.5 h-1.5 rounded-full bg-status-emerald animate-pulse"></span>
					<span>Systems &amp; AI Engineer &bull; Open Source Craftsman</span>
				</div>

				<!-- Headline & Position -->
				<div class="space-y-3 sm:space-y-4">
					<h1 class="text-3xl sm:text-5xl md:text-6xl font-sans font-semibold tracking-[-0.035em] text-text leading-[1.12]">
						Abhiuday &mdash; Systems &amp; AI Engineer. <span class="text-text-muted font-normal">Documenting the build, one commit at a time.</span>
					</h1>

					<p class="text-sm sm:text-base md:text-lg text-text-muted leading-relaxed max-w-2xl font-sans">
						Architecting autonomous agent runtimes, deterministic DAG workflow engines, and low-latency sandboxing infrastructure. Documenting internal design decisions and production post-mortems.
					</p>
				</div>

				<!-- Clean Action CTAs (Fluent Resend style) -->
				<div class="flex flex-wrap items-center gap-3 pt-2">
					<a class="btn-primary" href="#essays">
						<span>Read Latest Dispatch</span>
						<span aria-hidden="true">&rarr;</span>
					</a>
					<a class="btn-secondary" href="#systems">
						<span>Explore Systems</span>
						<span aria-hidden="true">&darr;</span>
					</a>
					<a class="btn-secondary" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
						<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
							<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
						</svg>
						<span>GitHub (@abhiudayg)</span>
					</a>
					<a class="btn-secondary" href="/subscribe">
						<svg class="w-3.5 h-3.5 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z"></path>
						</svg>
						<span>RSS Feed</span>
					</a>
				</div>

				<!-- Resend-Style Capability Pills (Replaces fake vanity stats with authentic badges) -->
				<div class="flex flex-wrap items-center gap-2 pt-6 border-t border-border font-mono text-xs text-text-dim">
					<span class="tag-pill text-text">Autonomous Agent Runtimes</span>
					<span class="text-border-hover">&bull;</span>
					<span class="tag-pill text-text">Local MCP Routing</span>
					<span class="text-border-hover">&bull;</span>
					<span class="tag-pill text-text">MicroVM Sandboxing</span>
					<span class="text-border-hover">&bull;</span>
					<span class="tag-pill text-text">100% Zero-Tracker RSS</span>
				</div>
			</section>

			<!-- 2. Featured Systems Bento Grid with GitHub Icons & Live Interactive DAG -->
			<section class="space-y-6 scroll-mt-20" id="systems">
				<div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-border pb-4 gap-3">
					<div>
						<span class="font-mono text-xs text-text-dim uppercase tracking-wider">// Engineered Artifacts</span>
						<h2 class="text-2xl sm:text-3xl font-semibold text-text mt-1 tracking-tight">Featured Systems &amp; Runtimes</h2>
					</div>

					<!-- Interactive Category Filter Tabs -->
					<div class="flex items-center gap-1.5 font-mono text-xs overflow-x-auto pb-1 sm:pb-0" id="system-filter-tabs">
						<button type="button" class="system-tab-btn active px-2.5 py-1 rounded-md bg-surface-card border border-border text-text font-medium cursor-pointer transition-colors" data-filter="all">All (5)</button>
						<button type="button" class="system-tab-btn px-2.5 py-1 rounded-md bg-transparent border border-transparent text-text-dim hover:text-text cursor-pointer transition-colors" data-filter="ai">AI Agents</button>
						<button type="button" class="system-tab-btn px-2.5 py-1 rounded-md bg-transparent border border-transparent text-text-dim hover:text-text cursor-pointer transition-colors" data-filter="systems">Rust &amp; Sandboxing</button>
					</div>
				</div>

				<!-- Bento Grid (Harmonic 12 Columns: Row 1 = 8+4, Row 2 = 4+4+4) -->
				<div class="grid grid-cols-1 md:grid-cols-12 gap-5" id="bento-grid-container">
					<!-- Bento Card 1: Large Span (Col 12 md:8) agent-brain -->
					<div class="system-card md:col-span-8 bg-surface-card border border-border rounded-xl p-6 md:p-8 bento-card-glow flex flex-col justify-between space-y-6" data-category="ai systems">
						<div class="space-y-3">
							<div class="flex items-center justify-between">
								<div class="flex items-center gap-3">
									<div class="w-8 h-8 rounded-lg bg-bg-subtle border border-border flex items-center justify-center text-status-emerald shrink-0">
										<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path>
										</svg>
									</div>
									<h3 class="text-xl font-semibold text-text tracking-tight">agent-brain</h3>
									<span class="px-2 py-0.5 rounded bg-bg border border-border font-mono text-[11px] text-text-muted">v0.9.4-rc</span>
								</div>
								
								<!-- GitHub Direct Button -->
								<a
									class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-bg-subtle border border-border text-text-muted hover:text-text hover:border-border-hover transition-colors font-mono text-xs no-underline"
									href="https://github.com/autonomic-ai-dev/agent-brain"
									target="_blank"
									rel="noopener noreferrer"
									aria-label="View agent-brain on GitHub"
								>
									<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
										<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
									</svg>
									<span>GitHub</span>
									<span aria-hidden="true">&nearr;</span>
								</a>
							</div>
							<p class="text-sm text-text-muted leading-relaxed">
								Autonomous hierarchical planning and memory runtime for multi-agent swarms with local MCP vector routing under token budget. Tokio channels, dynamic validation, and zero-copy gRPC serialization.
							</p>
						</div>

						<!-- Interactive Live DAG Playground Visualizer -->
						<div class="bg-code-bg border border-border rounded-lg p-4 font-mono text-xs space-y-3">
							<div class="flex items-center justify-between text-text-dim text-[11px] border-b border-border pb-2">
								<span class="flex items-center gap-1.5">
									<span class="w-1.5 h-1.5 rounded-full bg-status-emerald"></span>
									<span>Interactive DAG Engine &bull; Click nodes to inspect</span>
								</span>
								<span class="text-status-emerald font-medium" id="dag-mode-label">tokio::sync::broadcast</span>
							</div>

							<!-- Clickable Node Pipeline -->
							<div class="overflow-x-auto py-1">
								<div class="flex items-center gap-2 min-w-max text-xs">
									<button
										type="button"
										class="dag-node-btn px-2.5 py-1 rounded bg-surface-card border border-status-emerald text-text cursor-pointer hover:border-border-hover transition-colors font-mono"
										onclick="inspectDagStage('intent')"
										id="node-intent"
									>
										<span class="text-status-emerald">&gt;</span> Intent Planner
									</button>
									<span class="text-text-dim">&mdash;(mpsc)&rarr;</span>
									<button
										type="button"
										class="dag-node-btn px-2.5 py-1 rounded bg-surface-card border border-border text-text-muted cursor-pointer hover:border-border-hover transition-colors font-mono"
										onclick="inspectDagStage('validator')"
										id="node-validator"
									>
										Hierarchical Validator
									</button>
									<span class="text-text-dim">&mdash;(gRPC)&rarr;</span>
									<button
										type="button"
										class="dag-node-btn px-2.5 py-1 rounded bg-surface-card border border-border text-text-muted cursor-pointer hover:border-border-hover transition-colors font-mono"
