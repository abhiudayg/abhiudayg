---
import BaseHead from '../components/BaseHead.astro';
import EmpiricalBenchmarks from '../components/EmpiricalBenchmarks.astro';
import EvidenceInspector from '../components/EvidenceInspector.astro';
import FAQSection from '../components/FAQSection.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import HonestBoundaries from '../components/HonestBoundaries.astro';
import JsonLd from '../components/JsonLd.astro';
import MainOrangeArrow from '../components/MainOrangeArrow.astro';
import { BLOG_SERIES, GITHUB_URL, INSTAGRAM_URL, RSS_FEED_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getSortedPosts } from '../utils/blog';
import { graphJsonLd, personJsonLd, websiteJsonLd } from '../utils/seo';

const allPosts = await getSortedPosts();
const schema = graphJsonLd(websiteJsonLd(Astro.site), personJsonLd(Astro.site));

const seriesList = Object.entries(BLOG_SERIES).map(([slug, meta]) => ({
	slug,
	...meta,
	count: allPosts.filter((p) => p.data.series === slug).length,
}));
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<JsonLd schema={schema} />
	</head>
	<body class="relative min-h-screen bg-bg text-text antialiased selection:bg-surface-card selection:text-accent">
		<!-- Framer-Style Animated Moving Gradient Grid Background -->
		<div class="framer-grid-container" aria-hidden="true" id="framer-bg">
			<div class="framer-orb-1"></div>
			<div class="framer-orb-2"></div>
			<div class="framer-spotlight" id="framer-spotlight"></div>
			<div class="framer-grid-overlay"></div>
		</div>

		<Header />

		<div class="relative overflow-x-clip" id="conduit-parent">
			<MainOrangeArrow />

			<main class="shell relative py-12 sm:py-16 md:py-20 space-y-20 md:space-y-28 pl-6 sm:pl-10 md:pl-12 lg:pl-12 xl:pl-6">
			<!-- 1. Hero Section -->
			<section class="relative space-y-6 sm:space-y-8 max-w-4xl">
				<!-- Status Badge / Pill (Resend style) -->
				<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-card border border-border font-mono text-[11px] sm:text-xs text-text-muted">
					<span class="w-1.5 h-1.5 rounded-full bg-status-emerald animate-pulse"></span>
					<span>Systems &amp; AI Engineer &bull; Open Source Craftsman</span>
				</div>

				<!-- Headline & Position -->
				<div class="space-y-3 sm:space-y-4">
					<h1 class="text-3xl sm:text-5xl md:text-6xl font-sans font-semibold tracking-[-0.035em] text-text leading-[1.12]">
						Abhiuday &mdash; Systems &amp; AI Engineer. <span class="text-text-muted font-normal">Documenting the build, one commit at a time.</span>
					</h1>

					<p class="text-sm sm:text-base md:text-lg text-text-muted leading-relaxed max-w-2xl font-sans">
						Wrangling enterprise Java &amp; distributed payment ledgers by day ☕. Hacking on bare-metal Go, Rust, and autonomous agent runtimes by night 🚀.
					</p>
				</div>

				<!-- Clean Action CTAs (Fluent Resend style) -->
				<div class="flex flex-wrap items-center gap-3 pt-2">
					<a class="btn-primary" href="#essays">
						<span>Read Latest Dispatch</span>
						<span aria-hidden="true">&rarr;</span>
					</a>
					<a class="btn-secondary" href="#systems">
						<span>Explore Systems</span>
						<span aria-hidden="true">&darr;</span>
					</a>
					<a class="btn-secondary" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
						<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
							<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
						</svg>
						<span>GitHub (@abhiudayg)</span>
					</a>
					<a class="btn-secondary" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
						<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
							<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
						</svg>
						<span>@baremetal.dev</span>
					</a>
					<a class="btn-secondary" href="/subscribe">
