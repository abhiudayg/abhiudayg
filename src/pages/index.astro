							<div class="flex items-center justify-between">
								<div class="flex items-center gap-3">
									<div class="w-8 h-8 rounded-lg bg-bg-subtle border border-border flex items-center justify-center text-status-emerald shrink-0">
										<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
										</svg>
									</div>
									<h3 class="text-xl font-semibold text-text tracking-tight">tekmor</h3>
									<span class="px-2 py-0.5 rounded-full bg-status-emerald/10 border border-status-emerald/30 font-mono text-[11px] text-status-emerald font-medium">{BLOG_SERIES.tekmor.badge}</span>
								</div>
								
								<!-- GitHub Direct Button -->
								<a
									class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-bg-subtle border border-border text-text-muted hover:text-text hover:border-border-hover transition-colors font-mono text-xs no-underline"
									href="https://github.com/autonomic-ai-dev/tekmor"
