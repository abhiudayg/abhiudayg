									<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
										<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
									</svg>
									<span>GitHub</span>
									<span aria-hidden="true">&nearr;</span>
								</a>
							</div>
							<p class="text-sm text-text-muted leading-relaxed">
								Hard gate verification engine &amp; cryptographic test ledger for coding agents. Intercepts turns via host stop hooks, executes checks in isolated POSIX subshells, and binds exit codes to git tree SHAs.
							</p>
						</div>

						<!-- Telemetry Terminal -->
						<div class="bg-code-bg border border-border rounded-lg p-3 font-mono text-xs space-y-1.5 text-text-dim">
							<div class="flex justify-between">
								<span>Gate Integration:</span>
								<span class="text-status-emerald font-medium">Native Stop Hook in Claude Code</span>
							</div>
							<div class="flex justify-between">
								<span>Token Overhead:</span>
								<span class="text-text font-medium">0 model tokens (100% local deterministic code)</span>
							</div>
							<div class="flex justify-between">
								<span>Cryptographic Proof:</span>
								<span class="text-text font-medium">SHA-256 git tree binding (.verify/receipt.json)</span>
							</div>
						</div>

						<!-- Tags & Action -->
						<div class="flex flex-wrap items-center gap-2 pt-2 border-t border-border font-mono text-xs">
							<span class="tag-pill">Rust</span>
							<span class="tag-pill">POSIX Subshell</span>
							<span class="tag-pill">SHA-256</span>
							<span class="tag-pill">Claude Code Hooks</span>
							<a class="ml-auto text-text-dim hover:text-text no-underline flex items-center gap-1" href="#evidence-inspector">
