							<div class="flex items-center justify-between">
								<div class="flex items-center gap-2">
									<h3 class="text-lg font-semibold text-text tracking-tight">shipnote</h3>
									<span class="px-2 py-0.5 rounded-full bg-status-emerald/10 border border-status-emerald/30 font-mono text-[11px] text-status-emerald font-medium">{BLOG_SERIES.shipnote.badge}</span>
