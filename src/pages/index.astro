						<button type="button" class="system-tab-btn px-2.5 py-1 rounded-md bg-transparent border border-transparent text-text-dim hover:text-text cursor-pointer transition-colors" data-filter="ai">AI Verification &amp; Agents</button>
						<button type="button" class="system-tab-btn px-2.5 py-1 rounded-md bg-transparent border border-transparent text-text-dim hover:text-text cursor-pointer transition-colors" data-filter="tools">Developer Tools</button>
					</div>
				</div>

				<!-- Bento Grid (Harmonic 6x6 Layout: 3 Rows of 2 Symmetrical Cards) -->
