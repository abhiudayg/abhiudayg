					<!-- Bento Card 4: agent-spine (Col 12 md:4) -->
					<div class="system-card md:col-span-4 bg-surface-card border border-border rounded-xl p-6 bento-card-glow flex flex-col justify-between space-y-4" data-category="ai systems">
						<div class="space-y-2">
							<div class="flex items-center justify-between">
								<h3 class="text-base font-semibold text-text tracking-tight">agent-spine</h3>
								
