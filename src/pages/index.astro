									target="_blank"
									rel="noopener noreferrer"
									aria-label="View harbor on GitHub"
								>
									<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
										<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
									</svg>
									<span>&nearr;</span>
								</a>
							</div>
							<p class="text-xs text-text-muted leading-relaxed">
								Headless browser execution engine and DOM inspection sandbox designed specifically for autonomous agents and verification.
							</p>
						</div>
						<div class="flex flex-wrap items-center gap-1.5 pt-2 border-t border-border font-mono text-xs">
							<span class="tag-pill">TypeScript</span>
							<span class="tag-pill">Playwright</span>
							<span class="tag-pill">CDP</span>
							<a class="ml-auto text-text-dim hover:text-text no-underline" href="/blog/series/harbor/">
								View &rarr;
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- 3. Recent Engineering Dispatches (Blog Section) -->
			<section class="space-y-6 scroll-mt-20" id="essays">
				<div class="flex items-end justify-between border-b border-border pb-3">
					<div>
						<span class="font-mono text-xs text-text-dim uppercase tracking-wider">// Publications &amp; Post-Mortems</span>
						<h2 class="text-2xl sm:text-3xl font-semibold text-text mt-1 tracking-tight">Recent Engineering Dispatches</h2>
					</div>
					<a class="font-mono text-xs text-text-muted hover:text-text transition-colors no-underline flex items-center gap-1" href="/blog">
						<span>View Archive ({allPosts.length} posts)</span>
						<span aria-hidden="true">&rarr;</span>
					</a>
				</div>

				<!-- Essay List (Vercel / Resend clean row design) -->
				<div class="divide-y divide-border rounded-xl border border-border bg-surface-card overflow-hidden">
					{allPosts.slice(0, 5).map((post) => (
						<a class="p-5 sm:p-6 block hover:bg-bg-subtle transition-colors duration-150 no-underline text-inherit group" href={`/blog/${post.id}/`}>
							<div class="flex flex-col md:flex-row md:items-baseline justify-between gap-2">
								<div class="space-y-1.5 max-w-3xl">
									<div class="flex items-center gap-2 font-mono text-xs">
										{post.data.series && (
											<span class="tag-pill text-text font-medium">
												#{BLOG_SERIES[post.data.series as keyof typeof BLOG_SERIES]?.title ?? post.data.series}
											</span>
										)}
										<span class="text-text-dim">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</div>
									<h3 class="text-base sm:text-lg font-medium text-text group-hover:text-accent transition-colors">
										{post.data.title}
									</h3>
									<p class="text-xs sm:text-sm text-text-muted line-clamp-2 m-0">
										{post.data.description}
									</p>
								</div>
								<div class="flex items-center gap-1 font-mono text-xs text-text-dim group-hover:text-text transition-colors shrink-0 pt-2 md:pt-0">
									<span>Read dispatch</span>
									<span class="group-hover:translate-x-0.5 transition-transform" aria-hidden="true">&rarr;</span>
								</div>
							</div>
						</a>
					))}
				</div>
			</section>

			<!-- 4. Curated Architecture Tracks -->
			<section class="space-y-6 scroll-mt-20" id="series">
				<div class="border-b border-border pb-3">
					<span class="font-mono text-xs text-text-dim uppercase tracking-wider">// Systems Engineering In-Depth</span>
					<h2 class="text-2xl sm:text-3xl font-semibold text-text mt-1 tracking-tight">Deep Architectural Series</h2>
					<p class="text-xs sm:text-sm text-text-muted mt-1">
						Multi-part explorations tackling specific engineering challenges from architecture to production.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-5">
					{seriesList.map((series, idx) => (
						<div class="series-card group bento-card-glow">
							<div class="space-y-3">
								<div class="flex items-center justify-between font-mono text-xs">
									<span class="text-status-emerald font-semibold">Track 0{idx + 1}</span>
									<span class="tag-pill">
										{series.count} {series.count === 1 ? 'part' : 'parts'}
									</span>
								</div>

								<h3 class="text-base sm:text-lg font-medium text-text group-hover:text-accent transition-colors">
									<a class="text-inherit no-underline" href={`/blog/series/${series.slug}/`}>
										{series.title}
									</a>
								</h3>

								<p class="text-xs leading-relaxed text-text-muted">
									{series.description}
								</p>
							</div>

							<div class="mt-6 pt-4 border-t border-border flex items-center justify-between font-mono text-xs">
								<a class="text-text hover:text-accent no-underline flex items-center gap-1" href={`/blog/series/${series.slug}/`}>
									<span>Read track</span>
									<span aria-hidden="true">&rarr;</span>
								</a>
								{series.repoUrl && (
									<a class="text-text-dim hover:text-text no-underline" href={series.repoUrl} target="_blank" rel="noopener noreferrer">
										GitHub &nearr;
									</a>
								)}
							</div>
						</div>
					))}
				</div>
			</section>

			<!-- 5. Resend-Inspired RSS & Syndication Banner -->
			<section class="rounded-xl border border-border bg-surface-card p-6 sm:p-10 bento-card-glow relative overflow-hidden" id="rss">
				<div class="grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-8 items-center">
					<div class="space-y-3 md:col-span-7">
						<div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-bg border border-border font-mono text-xs text-text-muted">
							<span class="w-1.5 h-1.5 rounded-full bg-status-emerald"></span>
							<span>Zero Spam &bull; Terminal &amp; RSS Friendly</span>
						</div>
						<h2 class="text-2xl sm:text-3xl font-semibold text-text tracking-tight">
							Open Syndication for Engineers
						</h2>
						<p class="text-xs sm:text-sm text-text-muted leading-relaxed max-w-xl">
							No algorithmic feeds, paywalls, or tracking pixels. Subscribe via open RSS feed in your favorite reader (NetNewsWire, Feedly, Reeder, Readwise) to receive essays immediately when they ship.
						</p>
					</div>

					<div class="space-y-3 md:col-span-5">
						<div class="flex items-center gap-2 rounded-lg border border-border bg-code-bg p-2 font-mono text-xs">
							<input
								type="text"
								readonly
								value={RSS_FEED_URL}
								class="w-full bg-transparent px-2 text-text outline-none selection:bg-surface-card selection:text-text"
								aria-label="RSS Feed URL"
								id="rss-input"
							/>
							<button
								type="button"
								class="shrink-0 rounded bg-surface-card border border-border px-3 py-1.5 text-xs text-text hover:border-border-hover transition-colors cursor-pointer"
								id="rss-copy-btn"
								onclick="copyRssUrl()"
							>
								Copy RSS
							</button>
						</div>
						<div class="flex items-center justify-between text-xs text-text-dim font-mono">
							<a class="text-text hover:underline" href="/subscribe">Feed guide &rarr;</a>
							<a class="text-text-dim hover:text-text" href="/rss.xml" target="_blank">Direct XML link &nearr;</a>
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />

		<!-- Interactive Client-side Motion & DevEx Script -->
		<script is:inline>
			// Framer-style interactive mouse spotlight tracking
			const bgContainer = document.getElementById('framer-bg');
			if (bgContainer && window.matchMedia('(pointer: fine)').matches) {
				window.addEventListener('mousemove', (e) => {
					const x = (e.clientX / window.innerWidth) * 100;
					const y = (e.clientY / window.innerHeight) * 100;
					bgContainer.style.setProperty('--mouse-x', x + '%');
					bgContainer.style.setProperty('--mouse-y', y + '%');
				}, { passive: true });
			}

			function copyRssUrl() {
				const input = document.getElementById('rss-input');
				if (input) {
					navigator.clipboard.writeText(input.value);
					const btn = document.getElementById('rss-copy-btn');
					if (btn) {
						btn.textContent = 'Copied!';
						setTimeout(() => {
							btn.textContent = 'Copy RSS';
						}, 2000);
					}
				}
			}

			// Interactive DAG Stage Inspector
			const stages = {
				intent: {
					title: 'Intent Planner',
					mode: 'tokio::sync::broadcast',
					detail: 'Breakdown: decompose user goal into acyclic task graphs • mean latency: 120μs • memory: zero-alloc'
				},
				validator: {
					title: 'Hierarchical Validator',
					mode: 'tokio::sync::mpsc',
					detail: 'Cycle detection: Tarjan SCC • schema conformance: strict protobuf v3 • validation overhead: 45μs'
				},
				dispatcher: {
					title: 'Tool Dispatcher',
					mode: 'tonic::transport::Channel (gRPC)',
					detail: 'Stream dispatch: Tokio worker thread affinity • IPC zero-copy memory ring • throughput: 110,000 req/s'
				}
			};

			function inspectDagStage(stageKey) {
				const stage = stages[stageKey];
				if (!stage) return;

				document.getElementById('dag-mode-label').textContent = stage.mode;
				const infoEl = document.getElementById('dag-stage-info');
				if (infoEl) {
					infoEl.innerHTML = `
						<div class="flex justify-between text-text">
							<span class="text-status-emerald font-semibold">Active Stage: ${stage.title}</span>
							<span class="text-text-dim">IPC: zero-copy active</span>
						</div>
						<div class="text-text-muted">
							${stage.detail}
						</div>
					`;
				}

				['intent', 'validator', 'dispatcher'].forEach(k => {
					const node = document.getElementById('node-' + k);
					if (node) {
						if (k === stageKey) {
							node.classList.add('border-status-emerald', 'text-text');
							node.classList.remove('border-border', 'text-text-muted');
						} else {
							node.classList.remove('border-status-emerald', 'text-text');
							node.classList.add('border-border', 'text-text-muted');
						}
					}
				});
			}

			// Bento Grid Filter Tabs
			const tabBtns = document.querySelectorAll('.system-tab-btn');
			const cards = document.querySelectorAll('.system-card');

			tabBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					const filter = btn.getAttribute('data-filter');

					tabBtns.forEach(b => {
						b.classList.remove('active', 'bg-surface-card', 'border-border', 'text-text', 'font-medium');
						b.classList.add('bg-transparent', 'border-transparent', 'text-text-dim');
					});

					btn.classList.add('active', 'bg-surface-card', 'border-border', 'text-text', 'font-medium');
					btn.classList.remove('bg-transparent', 'border-transparent', 'text-text-dim');

					cards.forEach(card => {
						const categories = card.getAttribute('data-category') || '';
						if (filter === 'all' || categories.includes(filter)) {
							card.style.display = '';
						} else {
							card.style.display = 'none';
						}
					});
				});
			});
		</script>
	</body>
</html>
