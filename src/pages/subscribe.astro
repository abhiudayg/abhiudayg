---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import { AUTHOR_NAME, RSS_FEED_URL, SITE_TITLE } from '../consts';
import { absoluteUrl, breadcrumbJsonLd, graphJsonLd } from '../utils/seo';

const readers = [
	{
		name: 'Feedly',
		href: `https://feedly.com/i/subscription/feed/${encodeURIComponent(RSS_FEED_URL)}`,
		badge: 'Web / Mobile',
	},
	{
		name: 'Inoreader',
		href: `https://www.inoreader.com/?add_feed=${encodeURIComponent(RSS_FEED_URL)}`,
		badge: 'Web / API',
	},
	{
		name: 'NewsBlur',
		href: `https://newsblur.com/?url=${encodeURIComponent(RSS_FEED_URL)}`,
		badge: 'Open Source',
	},
	{
		name: 'NetNewsWire',
		href: 'https://netnewswire.com/',
		badge: 'macOS / iOS',
	},
];

const machineEndpoints = [
	{
		title: 'Full-Text RSS 2.0 Feed',
		path: '/rss.xml',
		format: 'XML (RSS 2.0)',
		purpose: 'Standard syndicated feed for newsreaders with full un-truncated Markdown',
	},
	{
		title: 'Agent & LLM Context Index',
		path: '/llms.txt',
		format: 'Markdown',
		purpose: 'Byte-budgeted project registry & dispatcher for Cursor, Claude Code, and autonomous agents',
	},
	{
		title: 'Complete Engineering Digest',
		path: '/llms-full.txt',
		format: 'Plaintext',
		purpose: 'Comprehensive architectural specifications, design doctrines, and system deep dives',
	},
	{
		title: 'XML Search Engine Sitemap',
		path: '/sitemap-index.xml',
		format: 'Sitemap XML',
		purpose: 'Full site index with lastmod timestamps and canonical path routing',
	},
];

const schema = graphJsonLd(
	{
		'@type': 'WebPage',
		name: 'Subscribe to Open RSS Dispatches',
		description: 'Subscribe to full-text open RSS dispatches on autonomous agent runtimes, systems engineering, and low-latency developer infrastructure.',
		url: absoluteUrl('/subscribe/', Astro.site),
		inLanguage: 'en-US',
	},
	breadcrumbJsonLd([
		{ name: 'Home', url: absoluteUrl('/', Astro.site) },
		{ name: 'Subscribe', url: absoluteUrl('/subscribe/', Astro.site) },
	]),
);
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead
			title={`Subscribe & Syndication — ${AUTHOR_NAME}`}
			description="Subscribe to full-text open RSS dispatches on autonomous agent runtimes, systems engineering, and low-latency developer infrastructure."
		/>
		<JsonLd schema={schema} />
	</head>
	<body class="relative min-h-screen bg-bg text-text antialiased selection:bg-surface-card selection:text-accent">
		<!-- Framer-Style Animated Moving Gradient Grid Background -->
		<div class="framer-grid-container" aria-hidden="true" id="framer-bg">
			<div class="framer-orb-1"></div>
			<div class="framer-orb-2"></div>
			<div class="framer-spotlight" id="framer-spotlight"></div>
			<div class="framer-grid-overlay"></div>
		</div>

		<Header />

		<main class="shell relative py-12 sm:py-16 md:py-20 space-y-16 max-w-4xl animate-fade-in">
			<!-- Header -->
			<header class="space-y-4 border-b border-border pb-10">
				<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-card border border-border font-mono text-xs text-text-muted">
					<span class="w-1.5 h-1.5 rounded-full bg-status-emerald animate-pulse"></span>
					<span>Open Syndication &bull; 100% Full-Text &bull; Zero Trackers</span>
				</div>
				<h1 class="text-3xl sm:text-5xl font-sans font-semibold tracking-[-0.035em] text-text leading-[1.15]">
					Subscribe &amp; Syndication
				</h1>
				<p class="text-base sm:text-lg text-text-muted leading-relaxed max-w-2xl">
					Direct syndication for developers, terminal hackers, and autonomous coding agents. No algorithm rankers, zero email spam, and zero surveillance pixels.
				</p>
			</header>

			<!-- 1. Interactive 1-Click Copy Terminal (Caveman CLI style) -->
			<section class="space-y-4">
				<div class="flex items-center justify-between">
					<span class="font-mono text-xs uppercase tracking-wider text-text-dim">// TERMINAL QUICK COPY</span>
					<span class="font-mono text-[11px] text-status-emerald">Canonical Endpoint</span>
				</div>

				<div class="caveman-panel p-6 sm:p-7 bento-card-glow space-y-4">
					<div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
						<div class="relative flex-1">
							<div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-text-dim font-mono text-xs">
								$
							</div>
							<input
								id="feed-url"
								class="w-full rounded-lg border border-border bg-code-bg pl-8 pr-4 py-2.5 font-mono text-xs text-text outline-none focus:border-border-hover selection:bg-surface-card selection:text-text cursor-text"
								type="text"
								value={RSS_FEED_URL}
								readonly
								aria-label="Raw RSS feed URL"
							/>
						</div>
						<button
							type="button"
							id="copy-feed-url"
							class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-text text-bg hover:bg-white transition-colors font-mono text-xs font-semibold shrink-0 cursor-pointer"
						>
							<svg id="copy-icon" class="w-3.5 h-3.5 fill-none stroke-current" viewBox="0 0 24 24">
								<rect x="9" y="9" width="13" height="13" rx="2" ry="2" stroke-width="2"></rect>
								<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" stroke-width="2"></path>
							</svg>
							<span id="copy-btn-text">Copy Feed URL</span>
						</button>
					</div>

					<div class="flex items-center justify-between text-[11px] font-mono text-text-dim pt-2 border-t border-border/50">
						<span>Format: RSS 2.0 Full-Text XML</span>
						<span id="copy-status" class="text-status-emerald font-medium transition-opacity duration-200"></span>
					</div>
				</div>
			</section>

			<!-- 2. For Agents & Machine Readers (Caveman style) -->
			<section class="space-y-4">
				<div class="flex items-center justify-between">
					<span class="font-mono text-xs uppercase tracking-wider text-text-dim">// FOR AGENTS &amp; MACHINE READERS</span>
					<span class="font-mono text-[11px] text-text-dim">4 Endpoints</span>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					{machineEndpoints.map((ep) => (
						<a href={ep.path} class="caveman-panel p-5 bento-card-glow no-underline group block space-y-2.5">
							<div class="flex items-center justify-between font-mono text-xs">
								<span class="font-semibold text-text group-hover:text-status-emerald transition-colors">
									{ep.title}
								</span>
								<span class="px-2 py-0.5 rounded bg-surface-card border border-border text-[10px] text-text-dim">
									{ep.format}
								</span>
							</div>
							<p class="text-xs text-text-muted leading-relaxed">
								{ep.purpose}
							</p>
							<div class="pt-2 border-t border-border/50 flex items-center justify-between font-mono text-[11px] text-text-dim">
								<code class="text-text font-mono text-[11px]">{ep.path}</code>
								<span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
							</div>
						</a>
					))}
				</div>
			</section>

			<!-- 3. Web & Cloud Readers Grid -->
			<section class="space-y-4">
				<div class="flex items-center justify-between">
					<span class="font-mono text-xs uppercase tracking-wider text-text-dim">// ONE-CLICK CLOUD READERS</span>
					<span class="font-mono text-[11px] text-text-dim">Web Subscriptions</span>
				</div>

				<div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
					{readers.map((reader) => (
						<a
							class="caveman-panel p-4 text-center bento-card-glow no-underline group block space-y-1.5"
							href={reader.href}
							target="_blank"
							rel="noopener noreferrer"
						>
							<div class="font-sans font-medium text-text group-hover:text-accent transition-colors text-sm">
								{reader.name} &nearr;
							</div>
							<div class="font-mono text-[10px] text-text-dim">
								{reader.badge}
							</div>
						</a>
					))}
				</div>
			</section>

			<!-- 4. The Zero-Tracker Manifesto -->
			<section class="caveman-panel p-6 sm:p-8 bento-card-glow space-y-4">
				<div class="flex items-center gap-2 font-mono text-xs text-status-emerald">
					<span class="w-1.5 h-1.5 rounded-full bg-status-emerald"></span>
					<span>Why decentralized RSS in 2026?</span>
				</div>
				<h2 class="text-lg font-semibold text-text">Own your information pipeline.</h2>
				<p class="text-sm text-text-muted leading-relaxed">
					Algorithmic feeds prioritize controversy, engagement bait, and paywalls over high-conviction engineering depth. RSS gives control back to the reader: every article is delivered chronologically in unadulterated Markdown with verified code snippets and zero marketing interception.
				</p>
			</section>
		</main>

		<Footer />

		<script is:inline>
			function setupSubscribe() {
				const input = document.getElementById('feed-url');
				const button = document.getElementById('copy-feed-url');
				const status = document.getElementById('copy-status');
				const btnText = document.getElementById('copy-btn-text');

				if (!input || !button || !status) return;

				button.onclick = async () => {
					const url = input.value;
					try {
						await navigator.clipboard.writeText(url);
					} catch {
						input.select();
						document.execCommand('copy');
					}
					status.textContent = '✓ Copied to clipboard';
					if (btnText) btnText.textContent = 'Copied!';
					setTimeout(() => {
						status.textContent = '';
						if (btnText) btnText.textContent = 'Copy Feed URL';
					}, 2500);
				};

				const bg = document.getElementById('framer-bg');
				if (bg) {
					document.addEventListener('pointermove', (e) => {
						bg.style.setProperty('--mouse-x', `${e.clientX}px`);
						bg.style.setProperty('--mouse-y', `${e.clientY}px`);
					});
				}
			}

			setupSubscribe();
			document.addEventListener('astro:page-load', setupSubscribe);
		</script>
	</body>
</html>
