---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import { AUTHOR_NAME } from '../consts';
import { absoluteUrl, breadcrumbJsonLd, graphJsonLd } from '../utils/seo';

const title = "The 16.7 Million Local IP Hack — The Bare-Metal Stack #02";
const description = "Run 50 local microservices on port 80 with 0 port collisions and 0 Docker networking bloat using the RFC 1122 Class A 127.0.0.0/8 loopback subnet.";

const schema = graphJsonLd(
	breadcrumbJsonLd([
		{ name: 'Home', url: absoluteUrl('/', Astro.site) },
		{ name: 'Loopbacks', url: absoluteUrl('/loopbacks/', Astro.site) },
	]),
);
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead title={`${title} — ${AUTHOR_NAME}`} description={description} />
		<JsonLd schema={schema} />
	</head>
	<body class="relative min-h-screen bg-bg text-text antialiased selection:bg-surface-card selection:text-accent">
		<!-- Framer-Style Animated Background -->
		<div class="framer-grid-container" aria-hidden="true" id="framer-bg">
			<div class="framer-orb-1"></div>
			<div class="framer-orb-2"></div>
			<div class="framer-spotlight" id="framer-spotlight"></div>
			<div class="framer-grid-overlay"></div>
		</div>

		<Header />

		<main class="shell relative py-12 sm:py-16 md:py-20 space-y-12 max-w-4xl animate-fade-in">
			<!-- Header Banner -->
			<header class="space-y-4 border-b border-border pb-10">
				<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-card border border-border font-mono text-xs text-text-muted">
					<span class="w-1.5 h-1.5 rounded-full bg-status-emerald animate-pulse"></span>
					<span class="text-accent font-semibold">The Bare-Metal Stack #02</span>
					<span>&bull; RFC 1122 Class A Loopback</span>
				</div>
				<h1 class="text-3xl sm:text-5xl font-sans font-bold tracking-[-0.035em] text-text leading-[1.15]">
					Run 50 Local Services on <span class="text-accent">Port 80</span>
				</h1>
				<p class="text-base sm:text-lg text-text-muted leading-relaxed max-w-2xl">
					Stop fighting <code class="font-mono text-sm bg-surface-card px-2 py-0.5 rounded text-status-rose">bind: address already in use :8080</code>.
					Your kernel reserves the entire <strong class="text-text">127.0.0.0/8</strong> subnet &mdash; that's <strong class="text-text">16,777,216</strong> private IP addresses running on your laptop right now.
				</p>
			</header>

			<!-- Quick Benchmark Matrix -->
			<section class="grid grid-cols-1 sm:grid-cols-3 gap-4">
				<div class="caveman-panel p-5 bento-card-glow space-y-1">
					<span class="font-mono text-xs text-text-dim uppercase tracking-wider">AVAILABLE LOOPBACK IPS</span>
					<div class="font-mono text-2xl font-bold text-accent">16,777,216</div>
					<div class="font-mono text-xs text-text-dim">127.0.0.1 → 127.255.255.254</div>
				</div>
				<div class="caveman-panel p-5 bento-card-glow space-y-1">
					<span class="font-mono text-xs text-text-dim uppercase tracking-wider">MEMORY OVERHEAD</span>
					<div class="font-mono text-2xl font-bold text-status-emerald">0 MB</div>
					<div class="font-mono text-xs text-text-dim">vs. ~500 MB Docker bridge</div>
				</div>
				<div class="caveman-panel p-5 bento-card-glow space-y-1">
					<span class="font-mono text-xs text-text-dim uppercase tracking-wider">NETWORK LATENCY</span>
					<div class="font-mono text-2xl font-bold text-status-emerald">0.01 ms</div>
					<div class="font-mono text-xs text-text-dim">In-kernel loopback routing</div>
				</div>
			</section>

			<!-- Step 1: Loopback Setup Script -->
			<section class="space-y-4">
				<div class="flex items-center justify-between">
					<h2 class="text-xl font-bold text-text flex items-center gap-2">
						<span class="flex items-center justify-center w-7 h-7 rounded-lg bg-accent/10 border border-accent/30 text-accent text-sm font-mono font-bold">1</span>
						Add Local IP Aliases (Linux &amp; macOS)
					</h2>
					<span class="font-mono text-xs text-text-dim">setup-loopbacks.sh</span>
				</div>
				<p class="text-sm text-text-muted leading-relaxed">
					Run this script once to alias local IPs <code class="font-mono text-xs text-text">127.0.0.2</code> through <code class="font-mono text-xs text-text">127.0.0.10</code> to your system loopback interface (<code class="font-mono text-xs text-text">lo</code> / <code class="font-mono text-xs text-text">lo0</code>):
				</p>
				<div class="caveman-panel p-4 bg-surface-card border border-border rounded-xl font-mono text-sm overflow-x-auto text-text-secondary space-y-2">
					<div class="flex items-center justify-between pb-2 border-b border-border/50 text-xs text-text-dim">
						<span>bash</span>
						<span>zero dependencies</span>
					</div>
					<pre class="text-xs sm:text-sm text-text leading-relaxed"><code>#!/usr/bin/env bash
# setup-loopbacks.sh &mdash; bind 127.0.0.2 through 127.0.0.10

for i in &#123;2..10&#125;; do
  if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS loopback alias
    sudo ifconfig lo0 alias 127.0.0.$i 255.0.0.0 2&gt;/dev/null
  else
    # Linux loopback alias
    sudo ip addr add 127.0.0.$i/8 dev lo 2&gt;/dev/null
  fi
done

echo "✅ 127.0.0.2 through 127.0.0.10 bound to local loopback."</code></pre>
				</div>
			</section>

			<!-- Step 2: /etc/hosts Mapping -->
			<section class="space-y-4">
				<div class="flex items-center justify-between">
					<h2 class="text-xl font-bold text-text flex items-center gap-2">
						<span class="flex items-center justify-center w-7 h-7 rounded-lg bg-accent/10 border border-accent/30 text-accent text-sm font-mono font-bold">2</span>
						Map Local Domains in /etc/hosts
					</h2>
					<span class="font-mono text-xs text-text-dim">/etc/hosts</span>
				</div>
				<p class="text-sm text-text-muted leading-relaxed">
					Give each local microservice its own clean domain. No need to memorize random ports:
				</p>
				<div class="caveman-panel p-4 bg-surface-card border border-border rounded-xl font-mono text-sm overflow-x-auto text-text-secondary space-y-2">
					<pre class="text-xs sm:text-sm text-text leading-relaxed"><code># Append to /etc/hosts
127.0.0.2   auth.local
127.0.0.3   db.local
127.0.0.4   api.local
127.0.0.5   worker.local</code></pre>
				</div>
			</section>

			<!-- Step 3: Caddy Reverse Proxy -->
			<section class="space-y-4">
				<div class="flex items-center justify-between">
					<h2 class="text-xl font-bold text-text flex items-center gap-2">
						<span class="flex items-center justify-center w-7 h-7 rounded-lg bg-accent/10 border border-accent/30 text-accent text-sm font-mono font-bold">3</span>
						Clean Routing with Caddy (Standard Port 80 &amp; 443)
					</h2>
					<span class="font-mono text-xs text-text-dim">Caddyfile</span>
				</div>
				<p class="text-sm text-text-muted leading-relaxed">
					Run Caddy as your lightweight edge router. It automatically issues trusted local TLS certs with <code class="font-mono text-xs text-text">caddy trust</code>:
				</p>
				<div class="caveman-panel p-4 bg-surface-card border border-border rounded-xl font-mono text-sm overflow-x-auto text-text-secondary space-y-2">
					<pre class="text-xs sm:text-sm text-text leading-relaxed"><code># Caddyfile
auth.local &#123;
    reverse_proxy 127.0.0.2:80
&#125;

api.local &#123;
    reverse_proxy 127.0.0.4:80
&#125;</code></pre>
				</div>
			</section>

			<!-- The Philosophy / Why It Works -->
			<section class="caveman-panel p-6 sm:p-8 bento-card-glow space-y-4">
				<h3 class="text-lg font-semibold text-text">Why This Beats Docker Bridge Networks</h3>
				<ul class="space-y-3 text-sm text-text-muted">
					<li class="flex items-start gap-2.5">
						<span class="text-status-emerald mt-0.5">✓</span>
						<span><strong class="text-text">0 MB Memory Overhead:</strong> Docker Desktop consumes 500 MB to 2 GB of RAM just running VM shims and proxy helpers. Native loopback uses zero extra memory.</span>
					</li>
					<li class="flex items-start gap-2.5">
						<span class="text-status-emerald mt-0.5">✓</span>
						<span><strong class="text-text">0 Port Conflicts:</strong> All services can bind to standard port 80 or 443 because they each have their own isolated IP address.</span>
					</li>
					<li class="flex items-start gap-2.5">
						<span class="text-status-emerald mt-0.5">✓</span>
						<span><strong class="text-text">Pure POSIX Standard:</strong> Governed by RFC 1122 since 1989. Supported out-of-the-box by Linux, macOS, and BSD.</span>
					</li>
				</ul>
			</section>

			<!-- Back to Content Reel Links -->
			<footer class="pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-text-dim">
				<div>The Bare-Metal Stack by <a href="/" class="text-text underline hover:text-accent">Abhiuday</a> &bull; Bengaluru</div>
				<div class="flex items-center gap-4">
					<a href="https://instagram.com/abhiudayg.dev" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">Instagram</a>
					<a href="https://github.com/abhiudayg" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">GitHub</a>
				</div>
			</footer>
		</main>

		<Footer />
	</body>
</html>
