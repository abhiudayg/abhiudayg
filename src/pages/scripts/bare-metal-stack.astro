---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import JsonLd from '../../components/JsonLd.astro';
import { AUTHOR_NAME } from '../../consts';
import { absoluteUrl, breadcrumbJsonLd, graphJsonLd } from '../../utils/seo';

const title = "The Bare-Metal Stack — All Episodes & Scripts";
const description = "Systems engineering without the cloud bloat. Linux kernel primitives, systemd orchestration, 16.7M loopbacks, and cgroups v2 resource limits.";

const schema = graphJsonLd(
	breadcrumbJsonLd([
		{ name: 'Home', url: absoluteUrl('/', Astro.site) },
		{ name: 'Scripts', url: absoluteUrl('/scripts/', Astro.site) },
		{ name: 'The Bare-Metal Stack', url: absoluteUrl('/scripts/bare-metal-stack/', Astro.site) },
	]),
);

const EPISODES = [
	{
		episode: "#01",
		title: "Stop Declaring Go Infrastructure Twice",
		tool: "anode deploy",
		status: "RELEASED",
		badgeColor: "status-emerald",
		duration: "0:48",
		reelUrl: "https://www.instagram.com/p/DfxvAs9TqWg/",
		summary: "Inspects Go AST directly to auto-detect routes and database connections. Generates systemd units with Caddy reverse proxy on Linux VPS with 18MB RAM footprint vs. 500MB Docker daemon.",
		quickCmd: "brew install abhiudayg/tap/anode",
		linkUrl: "https://anode.abhiudayg.dev",
		linkText: "Inspect Script & Telemetry →",
		tags: ["Go", "systemd", "Process Management", "18MB Footprint"],
	},
	{
		episode: "#02",
		title: "The 16.7 Million Local IP Hack (RFC 1122)",
		tool: "loopback.sh",
		status: "DROPS WED 7:30 PM",
		badgeColor: "accent",
		duration: null,
		reelUrl: null,
		summary: "Eliminates local port collision hell (:8080, :8081, :8082) by binding 50 local microservices to separate 127.0.0.X loopback IPs, all on standard Port 80 with 0 Docker networking overhead.",
		quickCmd: "curl -fsSL https://abhiudayg.dev/scripts/loopback.sh | sudo bash",
		linkUrl: "/scripts/loopback",
		linkText: "Inspect Script & Evidence →",
		tags: ["Networking", "RFC 1122", "127.0.0.0/8", "Caddy"],
	},
	{
		episode: "#03",
		title: "Linux cgroups v2 Memory Jail",
		tool: "cgroups-jail.sh",
		status: "COMING SOON",
		badgeColor: "text-dim",
		duration: null,
		reelUrl: null,
		summary: "Hard limits local dev processes to strictly 128MB RAM and 20% CPU using native Linux kernel cgroups v2 slices, without spinning up Docker, containerd, or Kubernetes.",
		quickCmd: "Coming in Episode #03",
		linkUrl: "#",
		linkText: "Preview Topic →",
		tags: ["cgroups v2", "Linux Kernel", "Memory Limits", "Isolation"],
	},
];
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead title={`${title} — ${AUTHOR_NAME}`} description={description} />
		<JsonLd schema={schema} />
	</head>
	<body class="relative min-h-screen bg-bg text-text antialiased selection:bg-surface-card selection:text-accent">
		<!-- Framer-Style Animated Background -->
		<div class="framer-grid-container" aria-hidden="true" id="framer-bg">
			<div class="framer-orb-1"></div>
			<div class="framer-orb-2"></div>
			<div class="framer-spotlight" id="framer-spotlight"></div>
			<div class="framer-grid-overlay"></div>
		</div>

		<Header />

		<main class="shell relative py-12 sm:py-16 md:py-20 space-y-12 max-w-4xl animate-fade-in">
			<!-- Breadcrumb & Header Banner -->
			<header class="space-y-4 border-b border-border pb-10">
				<div class="flex flex-wrap items-center gap-2">
					<a href="/scripts" class="font-mono text-xs text-text-dim hover:text-accent transition-colors flex items-center gap-1">
						<span>←</span> All Scripts
					</a>
					<span class="text-text-dim">&bull;</span>
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-card border border-border font-mono text-xs text-text-muted">
						<span class="w-1.5 h-1.5 rounded-full bg-status-emerald animate-pulse"></span>
						<span class="text-accent font-semibold">Series Hub</span>
						<span>&bull; @baremetal.dev</span>
					</div>
				</div>

				<h1 class="text-3xl sm:text-5xl font-sans font-bold tracking-[-0.035em] text-text leading-[1.15]">
					The Bare-Metal Stack
				</h1>
				<p class="text-base sm:text-lg text-text-muted leading-relaxed max-w-2xl">
					Systems engineering without the cloud bloat. A modular curriculum and bash automation toolchain replacing heavy container daemons with native Linux and POSIX kernel primitives.
				</p>
			</header>

			<!-- Live Search & Filter Bar -->
			<section class="space-y-4">
				<div class="relative">
					<input
						type="text"
						id="series-search-input"
						placeholder="Search episodes by keyword, tool, port, or tag... (e.g. 'cgroups', 'loopback', '80')"
						class="w-full bg-surface-card border border-border focus:border-accent rounded-xl px-4 py-3 pl-10 font-mono text-xs sm:text-sm text-text placeholder:text-text-dim outline-none transition-all shadow-inner"
						autocomplete="off"
					/>
					<svg class="w-4 h-4 text-text-dim absolute left-3.5 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
					</svg>
					<span id="series-match-count" class="absolute right-3.5 top-3.5 font-mono text-xs text-text-dim">
						3 episodes
					</span>
				</div>
			</section>

			<!-- Episode Timeline List -->
			<section class="space-y-6" id="episodes-container">
				{EPISODES.map((ep) => (
					<div class="episode-card caveman-panel p-6 sm:p-7 bento-card-glow rounded-xl border border-border bg-surface-card space-y-4 transition-all hover:border-accent/40" data-search={`${ep.episode} ${ep.title} ${ep.tool} ${ep.summary} ${ep.tags.join(' ')}`.toLowerCase()}>
						<!-- Episode Header -->
						<div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 border-b border-border/50 pb-3">
							<div class="space-y-1 min-w-0">
								<div class="flex items-center gap-2">
									<span class="font-mono text-xs px-2 py-0.5 rounded bg-accent/15 border border-accent/40 text-accent font-bold shrink-0">
										{ep.episode}
									</span>
									<span class="font-mono text-xs text-text-dim">{ep.tool}</span>
								</div>
								<h2 class="text-lg sm:text-xl font-bold text-text leading-snug">
									<a href={ep.linkUrl} target={ep.linkUrl.startsWith('http') ? '_blank' : '_self'} rel={ep.linkUrl.startsWith('http') ? 'noopener noreferrer' : undefined} class="hover:text-accent transition-colors">
										{ep.title}
									</a>
								</h2>
							</div>

							<!-- Badges: Status + Duration + Reel Link -->
							<div class="flex flex-wrap items-center gap-2 shrink-0">
								<!-- Video Duration Timer (Only if released) -->
								{ep.duration && (
									<span class="font-mono text-xs px-2.5 py-1 rounded bg-surface-card border border-border text-text-muted flex items-center gap-1.5">
										<span>⏱</span>
										<span>{ep.duration}</span>
									</span>
								)}

								<!-- Instagram Reel Link -->
								{ep.reelUrl && (
									<a
										href={ep.reelUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="font-mono text-xs px-2.5 py-1 rounded bg-pink-500/10 border border-pink-500/30 text-pink-400 hover:bg-pink-500/20 transition-colors flex items-center gap-1.5"
									>
										<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
											<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
										</svg>
										<span>Instagram Reel</span>
									</a>
								)}

								<!-- Status Pill -->
								<span class={`font-mono text-xs px-2.5 py-1 rounded bg-surface-card border border-border text-${ep.badgeColor}`}>
									{ep.status}
								</span>
							</div>
						</div>

						<!-- Summary -->
						<p class="text-sm text-text-muted leading-relaxed">
							{ep.summary}
						</p>

						<!-- Command Box & Action Link -->
						<div class="caveman-panel p-3 bg-bg border border-border/60 rounded-lg font-mono text-xs flex flex-col md:flex-row md:items-center justify-between gap-3 text-text">
							<div class="flex items-center gap-2 min-w-0 overflow-x-auto py-0.5">
								<span class="text-accent select-none shrink-0 font-bold">❯</span>
								<code class="text-text whitespace-nowrap select-all font-mono">{ep.quickCmd}</code>
							</div>
							{ep.linkUrl !== "#" && (
								<a
									href={ep.linkUrl}
									target={ep.linkUrl.startsWith('http') ? '_blank' : '_self'}
									rel={ep.linkUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
									class="text-accent hover:underline text-xs shrink-0 font-semibold inline-flex items-center gap-1 self-start md:self-auto pt-1 md:pt-0"
								>
									<span>{ep.linkText}</span>
								</a>
							)}
						</div>

						<!-- Tags -->
						<div class="flex flex-wrap gap-2 pt-1 font-mono text-[11px] text-text-dim">
							{ep.tags.map((t) => (
								<span class="px-2 py-0.5 rounded bg-surface-card border border-border/50">
									#{t}
								</span>
							))}
						</div>
					</div>
				))}
			</section>

			<!-- Footer -->
			<footer class="pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-text-dim">
				<div>The Bare-Metal Stack by <a href="/" class="text-text underline hover:text-accent">Abhiuday</a> &bull; Bengaluru</div>
				<div class="flex items-center gap-4">
					<a href="/scripts" class="hover:text-accent transition-colors">All Scripts</a>
					<a href="https://instagram.com/baremetal.dev" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">Instagram (@baremetal.dev)</a>
					<a href="https://github.com/abhiudayg" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">GitHub</a>
				</div>
			</footer>
		</main>

		<Footer />

		<script>
			// Client-Side Realtime Search Filter
			const searchInput = document.getElementById('series-search-input') as HTMLInputElement | null;
			const matchCount = document.getElementById('series-match-count');
			const cards = document.querySelectorAll('.episode-card');

			if (searchInput && cards.length > 0) {
				searchInput.addEventListener('input', () => {
					const query = searchInput.value.toLowerCase().trim();
					let visible = 0;

					cards.forEach((card) => {
						const searchData = card.getAttribute('data-search') || '';
						if (!query || searchData.includes(query)) {
							(card as HTMLElement).style.display = 'block';
							visible++;
						} else {
							(card as HTMLElement).style.display = 'none';
						}
					});

					if (matchCount) {
						matchCount.innerText = `${visible} of ${cards.length} episodes`;
					}
				});
			}
		</script>
	</body>
</html>
