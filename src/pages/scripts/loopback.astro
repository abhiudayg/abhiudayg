---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import JsonLd from '../../components/JsonLd.astro';
import { AUTHOR_NAME } from '../../consts';
import { absoluteUrl, breadcrumbJsonLd, graphJsonLd } from '../../utils/seo';

const title = "Loopback Sharding: Three Services, Zero Port Collisions — Bare-Metal Logs #02";
const description = "Two services can't both listen on 127.0.0.1:8080. This setup gives each service its own loopback IP, keeps the port the same, and uses Caddy on port 80 to route by hostname.";

const schema = graphJsonLd(
	breadcrumbJsonLd([
		{ name: 'Home', url: absoluteUrl('/', Astro.site) },
		{ name: 'Scripts', url: absoluteUrl('/scripts/', Astro.site) },
		{ name: 'Loopback Sharding', url: absoluteUrl('/scripts/loopback/', Astro.site) },
	]),
);

const RAW_SCRIPT_URL = "https://abhiudayg.dev/scripts/loopback.sh";
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead title={`${title} — ${AUTHOR_NAME}`} description={description} />
		<JsonLd schema={schema} />
	</head>
	<body class="relative min-h-screen bg-bg text-text antialiased selection:bg-surface-card selection:text-accent">
		<!-- Framer-Style Animated Background -->
		<div class="framer-grid-container" aria-hidden="true" id="framer-bg">
			<div class="framer-orb-1"></div>
			<div class="framer-orb-2"></div>
			<div class="framer-spotlight" id="framer-spotlight"></div>
			<div class="framer-grid-overlay"></div>
		</div>

		<Header />

		<main class="shell relative py-12 sm:py-16 md:py-20 space-y-12 max-w-4xl animate-fade-in">
			<!-- Header Banner -->
			<header class="space-y-4 border-b border-border pb-8">
				<div class="flex flex-wrap items-center gap-2">
					<a href="/scripts" class="font-mono text-xs text-text-dim hover:text-accent transition-colors flex items-center gap-1">
						<span>←</span> All Scripts
					</a>
					<span class="text-text-dim">&bull;</span>
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-card border border-border font-mono text-xs text-text-muted">
						<span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
						<span class="text-accent font-semibold">Bare-Metal Logs #02</span>
						<span>&bull; Loopback Sharding</span>
					</div>
				</div>

				<h1 class="text-3xl sm:text-5xl font-sans font-bold tracking-[-0.035em] text-text leading-[1.15]">
					Loopback Sharding: Three Services, Zero Port Collisions
				</h1>
				<p class="text-base sm:text-lg text-text-muted leading-relaxed max-w-3xl">
					Two services can't both listen on <code class="font-mono text-xs bg-surface-card px-1.5 py-0.5 rounded text-accent">127.0.0.1:8080</code>. This setup gives each service its own loopback IP, keeps the port the same, and uses Caddy on port 80 to route by hostname.
				</p>
			</header>

			<!-- 1. The Script & Setup -->
			<section class="space-y-4">
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
					<div>
						<h2 class="text-xl font-bold text-text flex items-center gap-2">
							<span class="flex items-center justify-center w-7 h-7 rounded-lg bg-accent/10 border border-accent/30 text-accent text-sm font-mono font-bold">1</span>
							Setup
						</h2>
						<p class="text-xs sm:text-sm text-text-muted mt-0.5">
							Automates loopback aliases, hosts file routing, and Caddyfile generation.
						</p>
					</div>

					<div class="flex items-center gap-2">
						<button
							type="button"
							id="copy-script-btn"
							class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-accent text-bg font-mono text-xs font-bold hover:bg-accent/90 transition-all cursor-pointer shadow-lg shadow-accent/20"
						>
							<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
							</svg>
							<span id="copy-text">Copy Script</span>
						</button>
						<a
							href="/scripts/loopback.sh"
							download="loopback.sh"
							class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-card border border-border text-text font-mono text-xs hover:border-text-dim transition-colors"
						>
							Download .sh
						</a>
					</div>
				</div>

				<div class="caveman-panel p-4 bg-surface-card border border-border rounded-xl font-mono text-sm flex items-center justify-between gap-2 overflow-x-auto">
					<div class="flex items-center gap-2 text-text">
						<span class="text-accent">❯</span>
						<span class="font-bold">sudo bash loopback.sh</span>
					</div>
				</div>

				<div class="space-y-2 text-sm text-text-muted leading-relaxed">
					<p>The script does three things:</p>
					<ul class="list-disc list-inside space-y-1 pl-2">
						<li>Binds <code class="font-mono text-xs text-text">127.0.0.2</code> and <code class="font-mono text-xs text-text">127.0.0.3</code> to the loopback interface. On macOS it uses <code class="font-mono text-xs text-accent">ifconfig lo0 alias</code>. On Linux it uses <code class="font-mono text-xs text-accent">ip addr add</code>.</li>
						<li>Adds a block to <code class="font-mono text-xs text-text">/etc/hosts</code> that maps <code class="font-mono text-xs text-text">auth.test</code> and <code class="font-mono text-xs text-text">api.test</code> to <code class="font-mono text-xs text-text">127.0.0.1</code>. A backup of the original file is saved as <code class="font-mono text-xs text-text">/etc/hosts.bare-metal-backup</code>.</li>
						<li>Writes a <code class="font-mono text-xs text-text">Caddyfile</code> that routes <code class="font-mono text-xs text-text">http://auth.test</code> to <code class="font-mono text-xs text-accent">127.0.0.2:8080</code> and <code class="font-mono text-xs text-text">http://api.test</code> to <code class="font-mono text-xs text-accent">127.0.0.3:8080</code>.</li>
					</ul>
					<p class="text-xs text-text-dim pt-1">Nothing is installed, and no Docker is required.</p>
				</div>

				<!-- Full Script Code View -->
				<div class="caveman-panel p-5 bg-surface-card border border-border rounded-xl font-mono text-xs overflow-x-auto text-text-secondary space-y-2 max-h-[420px] overflow-y-auto">
					<div class="flex items-center justify-between pb-3 border-b border-border/50 text-xs text-text-dim">
						<span>loopback.sh &bull; 200 lines</span>
						<span>macOS (lo0) &amp; Linux (lo) compatible</span>
					</div>
					<pre id="raw-script-code" class="text-xs text-text leading-relaxed"><code>#!/usr/bin/env bash
# ==============================================================================
# Bare-Metal Logs #02: Loopback Sharding (loopback.sh)
# https://abhiudayg.dev/scripts/loopback
#
# Binds two shard IPs (127.0.0.2 and 127.0.0.3) on the loopback interface,
# maps auth.test and api.test to 127.0.0.1, and writes a Caddyfile that routes
# http://auth.test and http://api.test on 127.0.0.1:80.
# ==============================================================================
set -euo pipefail

HOSTS_START="# BEGIN BARE_METAL_LOOPBACKS"
HOSTS_END="# END BARE_METAL_LOOPBACKS"
SHARD_PORT=8080

SHARDS=(
  "127.0.0.2 auth.test"
  "127.0.0.3 api.test"
)

# [See full script via Copy or Download above]</code></pre>
				</div>
			</section>

			<!-- 2. Run your services -->
			<section class="space-y-4">
				<h2 class="text-xl font-bold text-text flex items-center gap-2">
					<span class="flex items-center justify-center w-7 h-7 rounded-lg bg-accent/10 border border-accent/30 text-accent text-sm font-mono font-bold">2</span>
					Run your services
				</h2>
				<p class="text-sm text-text-muted">
					Start each service on its own IP and the same port:
				</p>
				<div class="caveman-panel p-4 bg-surface-card border border-border rounded-xl font-mono text-xs sm:text-sm space-y-1">
					<div class="text-text"><span class="text-accent">❯</span> ./auth --listen 127.0.0.2:8080</div>
					<div class="text-text"><span class="text-accent">❯</span> ./api  --listen 127.0.0.3:8080</div>
				</div>
				<p class="text-xs sm:text-sm text-text-muted">
					If you run both on <code class="font-mono text-xs text-text">127.0.0.1:8080</code>, the second one fails with <code class="font-mono text-xs text-accent">address already in use</code>. That's the collision this setup removes.
				</p>
			</section>

			<!-- 3. Start Caddy -->
			<section class="space-y-4">
				<h2 class="text-xl font-bold text-text flex items-center gap-2">
					<span class="flex items-center justify-center w-7 h-7 rounded-lg bg-accent/10 border border-accent/30 text-accent text-sm font-mono font-bold">3</span>
					Start Caddy
				</h2>
				<div class="caveman-panel p-4 bg-surface-card border border-border rounded-xl font-mono text-xs sm:text-sm">
					<div class="text-text"><span class="text-accent">❯</span> sudo caddy run --config Caddyfile</div>
				</div>
				<p class="text-xs sm:text-sm text-text-muted">
					Caddy listens on <code class="font-mono text-xs text-text">127.0.0.1:80</code>. The site blocks use <code class="font-mono text-xs text-text">http://</code>, so no HTTPS certificates are involved.
				</p>
			</section>

			<!-- 4. Test -->
			<section class="space-y-4">
				<h2 class="text-xl font-bold text-text flex items-center gap-2">
					<span class="flex items-center justify-center w-7 h-7 rounded-lg bg-accent/10 border border-accent/30 text-accent text-sm font-mono font-bold">4</span>
					Test
				</h2>
				<div class="caveman-panel p-4 bg-surface-card border border-border rounded-xl font-mono text-xs sm:text-sm space-y-1">
					<div class="text-text"><span class="text-accent">❯</span> curl -i http://auth.test</div>
					<div class="text-text"><span class="text-accent">❯</span> curl -i http://api.test</div>
				</div>
			</section>

			<!-- 5. Check or revert -->
			<section class="space-y-4">
				<h2 class="text-xl font-bold text-text flex items-center gap-2">
					<span class="flex items-center justify-center w-7 h-7 rounded-lg bg-accent/10 border border-accent/30 text-accent text-sm font-mono font-bold">5</span>
					Check or revert
				</h2>
				<div class="caveman-panel p-4 bg-surface-card border border-border rounded-xl font-mono text-xs sm:text-sm space-y-1">
					<div class="text-text"><span class="text-accent">❯</span> sudo bash loopback.sh --status</div>
					<div class="text-text"><span class="text-accent">❯</span> sudo bash loopback.sh --uninstall</div>
				</div>
				<p class="text-xs sm:text-sm text-text-muted leading-relaxed">
					<code class="font-mono text-xs text-accent">--uninstall</code> removes both aliases and the hosts block. It leaves the Caddyfile in place. Aliases don't survive a reboot. Run the setup again after restarting.
				</p>
			</section>

			<!-- 6. Evidence -->
			<section class="space-y-4">
				<div class="flex items-center justify-between border-b border-border pb-3">
					<div>
						<h2 class="text-xl font-bold text-text flex items-center gap-2">
							<span class="flex items-center justify-center w-7 h-7 rounded-lg bg-accent/10 border border-accent/30 text-accent text-sm font-mono font-bold">6</span>
							Evidence
						</h2>
						<p class="text-xs sm:text-sm text-text-muted mt-0.5">
							Live telemetry captured directly on the filming machine.
						</p>
					</div>
					<span class="font-mono text-xs text-accent flex items-center gap-1.5">
						<span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
						Tested on macOS Sonoma &amp; Ubuntu 24.04
					</span>
				</div>

				<!-- Collision & Resolution Terminal Box -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<div class="caveman-panel p-4 bg-surface-card border border-border rounded-xl space-y-2 font-mono text-xs">
						<div class="text-text-dim flex justify-between">
							<span>COLLISION (SAME IP &middot; SAME PORT)</span>
							<span class="text-accent font-bold">EXIT 1</span>
						</div>
						<pre class="text-text text-[11px] leading-relaxed overflow-x-auto"><code>$ ./auth --listen 127.0.0.1:8080
[ok] auth listening on 127.0.0.1:8080

$ ./api --listen 127.0.0.1:8080
listen tcp 127.0.0.1:8080: bind: address already in use
exit status 1</code></pre>
					</div>

					<div class="caveman-panel p-4 bg-surface-card border border-border rounded-xl space-y-2 font-mono text-xs">
						<div class="text-text-dim flex justify-between">
							<span>SHARDED (DIFFERENT IP &middot; SAME PORT)</span>
							<span class="text-status-emerald font-bold">LISTENING</span>
						</div>
						<pre class="text-text text-[11px] leading-relaxed overflow-x-auto"><code>$ ./auth --listen 127.0.0.2:8080
[ok] auth listening on 127.0.0.2:8080

$ ./api --listen 127.0.0.3:8080
[ok] api listening on 127.0.0.3:8080</code></pre>
					</div>
				</div>

				<div class="caveman-panel p-4 bg-surface-card border border-border rounded-xl font-mono text-xs space-y-2">
					<div class="text-text-dim flex justify-between">
						<span>$ curl -i http://auth.test &amp;&amp; curl -i http://api.test</span>
						<span class="text-status-emerald">HTTP/1.1 200 OK</span>
					</div>
					<pre class="text-text-muted text-[11px] leading-relaxed overflow-x-auto"><code>HTTP/1.1 200 OK
Server: Caddy
Date: Mon, 16 Nov 2026 16:30:00 GMT
Content-Length: 18

&#123;"service":"auth"&#125;

HTTP/1.1 200 OK
Server: Caddy
Date: Mon, 16 Nov 2026 16:30:00 GMT
Content-Length: 17

&#123;"service":"api"&#125;</code></pre>
				</div>
			</section>

			<!-- 7. Tested on -->
			<section class="caveman-panel p-4 bg-surface-card border border-border rounded-xl font-mono text-xs space-y-1">
				<span class="text-text-dim uppercase tracking-wider">TESTED ON</span>
				<div class="text-text">macOS Sonoma (Darwin 24.1.0 arm64), filmed on November 16, 2026. Verified on Ubuntu 24.04 LTS (kernel 6.8).</div>
			</section>

			<!-- Footer Links -->
			<footer class="pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-text-dim">
				<div>Bare-Metal Logs by <a href="/" class="text-text underline hover:text-accent">Abhiuday</a> &bull; Bengaluru</div>
				<div class="flex items-center gap-4">
					<a href="/scripts" class="hover:text-accent transition-colors">All Scripts</a>
					<a href="https://instagram.com/baremetal.dev" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">Instagram</a>
					<a href="https://github.com/abhiudayg" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">GitHub</a>
				</div>
			</footer>
		</main>

		<Footer />

		<script>
			const copyBtn = document.getElementById('copy-script-btn');
			const copyText = document.getElementById('copy-text');

			if (copyBtn) {
				copyBtn.addEventListener('click', async () => {
					try {
						const response = await fetch('/scripts/loopback.sh');
						const text = await response.text();
						await navigator.clipboard.writeText(text);
						if (copyText) {
							copyText.innerText = 'Copied!';
							setTimeout(() => {
								copyText.innerText = 'Copy Script';
							}, 2000);
						}
					} catch (e) {
						console.error('Failed to copy', e);
					}
				});
			}
		</script>
	</body>
</html>
