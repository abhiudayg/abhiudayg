---
import fs from 'node:fs';
import path from 'node:path';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import JsonLd from '../../components/JsonLd.astro';
import { AUTHOR_NAME } from '../../consts';
import { absoluteUrl, breadcrumbJsonLd, graphJsonLd } from '../../utils/seo';

const title = "Loopback Sharding: Three Services, Zero Port Collisions — Bare-Metal Logs #02";
const description = "Two services can't both listen on 127.0.0.1:8080. This setup gives each service its own loopback IP, keeps the port the same, and uses Caddy on port 80 to route by hostname.";

const schema = graphJsonLd(
	breadcrumbJsonLd([
		{ name: 'Home', url: absoluteUrl('/', Astro.site) },
		{ name: 'Scripts', url: absoluteUrl('/scripts/', Astro.site) },
		{ name: 'Loopback Sharding', url: absoluteUrl('/scripts/loopback/', Astro.site) },
	]),
);

// Read raw script at build time
const scriptPath = path.resolve('./public/scripts/loopback.sh');
const rawScript = fs.readFileSync(scriptPath, 'utf-8');
const lineCount = rawScript.trim().split('\n').length;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead title={`${title} — ${AUTHOR_NAME}`} description={description} />
		<JsonLd schema={schema} />
		<style>
			/* Subtle tactile hover effects */
			.code-panel {
				background: var(--surface-card);
				border: 1px solid var(--border);
				border-radius: 12px;
				transition: border-color 0.2s ease, box-shadow 0.2s ease;
			}
			.code-panel:hover {
				border-color: var(--border-hover);
			}
			.copy-btn {
				transition: all 0.15s ease;
			}
			.copy-btn:hover {
				background: rgba(255, 255, 255, 0.08);
				color: var(--text);
			}
		</style>
	</head>
	<body class="relative min-h-screen bg-bg text-text antialiased selection:bg-surface-card selection:text-accent">
		<!-- Framer-Style Animated Background -->
		<div class="framer-grid-container" aria-hidden="true" id="framer-bg">
			<div class="framer-orb-1"></div>
			<div class="framer-orb-2"></div>
			<div class="framer-spotlight" id="framer-spotlight"></div>
			<div class="framer-grid-overlay"></div>
		</div>

		<Header />

		<main class="shell relative py-12 sm:py-16 md:py-20 space-y-12 max-w-3xl animate-fade-in">
			<!-- Header Banner -->
			<header class="space-y-4 border-b border-border pb-8">
				<div class="flex flex-wrap items-center gap-2">
					<a href="/scripts" class="font-mono text-xs text-text-dim hover:text-accent transition-colors flex items-center gap-1">
						<span>←</span> All Scripts
					</a>
					<span class="text-text-dim">&bull;</span>
					<div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-surface-card border border-border font-mono text-xs text-text-muted">
						<span class="w-1.5 h-1.5 rounded-full bg-[#F97316]"></span>
						<span class="text-text font-medium">Bare-Metal Logs #02</span>
					</div>
				</div>

				<div class="space-y-2">
					<h1 class="text-3xl sm:text-4xl font-sans font-bold tracking-[-0.03em] text-text leading-[1.2]">
						Loopback Sharding: Three Services, Zero Port Collisions
					</h1>
					<p class="font-sans italic text-sm text-text-dim">
						Bare-Metal Logs #02
					</p>
				</div>

				<p class="text-base sm:text-lg text-text-muted leading-relaxed">
					Two services can't both listen on <code class="font-mono text-xs bg-surface-card border border-border/80 px-1.5 py-0.5 rounded text-text font-semibold">127.0.0.1:8080</code>. This setup gives each service its own loopback IP, keeps the port the same, and uses Caddy on port 80 to route by hostname.
				</p>
			</header>

			<!-- ## Setup -->
			<section class="space-y-4">
				<div class="flex items-center justify-between">
					<h2 class="text-xl sm:text-2xl font-sans font-bold tracking-tight text-text">
						Setup
					</h2>
					<div class="flex items-center gap-2">
						<button
							type="button"
							id="copy-script-btn"
							class="copy-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-card border border-border text-text-muted hover:text-text font-mono text-xs cursor-pointer"
						>
							<svg class="w-3.5 h-3.5 text-[#F97316]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
							</svg>
							<span id="copy-script-text">Copy loopback.sh</span>
						</button>
						<a
							href="/scripts/loopback.sh"
							download="loopback.sh"
							class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-card border border-border text-text-muted hover:text-text font-mono text-xs transition-colors"
						>
							Download .sh
						</a>
					</div>
				</div>

				<!-- Command Box -->
				<div class="code-panel overflow-hidden">
					<div class="flex items-center justify-between px-4 py-2 border-b border-border/40 bg-surface-card/40 text-xs font-mono text-text-dim">
						<span class="flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-border"></span>
							<span>bash</span>
						</span>
						<button class="copy-cmd-btn text-text-dim hover:text-text text-[11px] font-mono transition-colors" data-cmd="sudo bash loopback.sh">
							Copy
						</button>
					</div>
					<pre class="p-4 font-mono text-sm text-text overflow-x-auto"><code><span class="text-[#F97316] select-none">❯ </span>sudo bash loopback.sh</code></pre>
				</div>

				<div class="space-y-2 text-sm text-text-muted leading-relaxed pt-1">
					<p>The script does three things:</p>
					<ul class="list-disc list-inside space-y-1.5 pl-1">
						<li>
							Binds <code class="font-mono text-xs text-text bg-surface-card px-1 py-0.5 rounded">127.0.0.2</code> and <code class="font-mono text-xs text-text bg-surface-card px-1 py-0.5 rounded">127.0.0.3</code> to the loopback interface. On macOS it uses <code class="font-mono text-xs text-[#F97316]">ifconfig lo0 alias</code>. On Linux it uses <code class="font-mono text-xs text-[#F97316]">ip addr add</code>.
						</li>
						<li>
							Adds a block to <code class="font-mono text-xs text-text bg-surface-card px-1 py-0.5 rounded">/etc/hosts</code> that maps <code class="font-mono text-xs text-text bg-surface-card px-1 py-0.5 rounded">auth.test</code> and <code class="font-mono text-xs text-text bg-surface-card px-1 py-0.5 rounded">api.test</code> to <code class="font-mono text-xs text-text bg-surface-card px-1 py-0.5 rounded">127.0.0.1</code>. A backup of the original file is saved as <code class="font-mono text-xs text-text-muted">/etc/hosts.bare-metal-backup</code>.
						</li>
						<li>
							Writes a <code class="font-mono text-xs text-text bg-surface-card px-1 py-0.5 rounded">Caddyfile</code> that routes <code class="font-mono text-xs text-text bg-surface-card px-1 py-0.5 rounded">http://auth.test</code> to <code class="font-mono text-xs text-text bg-surface-card px-1 py-0.5 rounded">127.0.0.2:8080</code> and <code class="font-mono text-xs text-text bg-surface-card px-1 py-0.5 rounded">http://api.test</code> to <code class="font-mono text-xs text-text bg-surface-card px-1 py-0.5 rounded">127.0.0.3:8080</code>.
						</li>
					</ul>
					<p class="text-xs text-text-dim pt-1 font-mono">
						Nothing is installed, and no Docker is required.
					</p>
				</div>

				<!-- Collapsible Full Script Viewer -->
				<details class="group code-panel overflow-hidden mt-3">
					<summary class="flex items-center justify-between px-4 py-2.5 cursor-pointer select-none bg-surface-card/60 text-xs font-mono text-text-dim hover:text-text transition-colors">
						<div class="flex items-center gap-2">
							<span class="group-open:rotate-90 transition-transform">▸</span>
							<span class="font-bold text-text">loopback.sh</span>
							<span>&bull; {lineCount} lines</span>
						</div>
						<span class="text-[11px] text-text-dim">macOS (lo0) &amp; Linux (lo) compatible</span>
					</summary>
					<div class="p-4 border-t border-border/40 font-mono text-xs text-text-secondary overflow-x-auto max-h-[460px] overflow-y-auto leading-relaxed">
						<pre class="text-text/90"><code>{rawScript}</code></pre>
					</div>
				</details>
			</section>

			<!-- ## Run your services -->
			<section class="space-y-4">
				<h2 class="text-xl sm:text-2xl font-sans font-bold tracking-tight text-text">
					Run your services
				</h2>
				<p class="text-sm text-text-muted">
					Start each service on its own IP and the same port:
				</p>
				<div class="code-panel overflow-hidden">
					<div class="flex items-center justify-between px-4 py-2 border-b border-border/40 bg-surface-card/40 text-xs font-mono text-text-dim">
						<span class="flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-border"></span>
							<span>bash</span>
						</span>
						<button class="copy-cmd-btn text-text-dim hover:text-text text-[11px] font-mono transition-colors" data-cmd={"./auth --listen 127.0.0.2:8080\n./api  --listen 127.0.0.3:8080"}>
							Copy
						</button>
					</div>
					<pre class="p-4 font-mono text-xs sm:text-sm text-text overflow-x-auto space-y-1"><code><div><span class="text-[#F97316] select-none">❯ </span>./auth --listen 127.0.0.2:8080</div><div><span class="text-[#F97316] select-none">❯ </span>./api  --listen 127.0.0.3:8080</div></code></pre>
				</div>
				<p class="text-xs sm:text-sm text-text-muted leading-relaxed">
					If you run both on <code class="font-mono text-xs text-text bg-surface-card px-1 py-0.5 rounded">127.0.0.1:8080</code>, the second one fails with <code class="font-mono text-xs text-[#F97316]">address already in use</code>. That's the collision this setup removes.
				</p>
			</section>

			<!-- ## Start Caddy -->
			<section class="space-y-4">
				<h2 class="text-xl sm:text-2xl font-sans font-bold tracking-tight text-text">
					Start Caddy
				</h2>
				<div class="code-panel overflow-hidden">
					<div class="flex items-center justify-between px-4 py-2 border-b border-border/40 bg-surface-card/40 text-xs font-mono text-text-dim">
						<span class="flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-border"></span>
							<span>bash</span>
						</span>
						<button class="copy-cmd-btn text-text-dim hover:text-text text-[11px] font-mono transition-colors" data-cmd="sudo caddy run --config Caddyfile">
							Copy
						</button>
					</div>
					<pre class="p-4 font-mono text-xs sm:text-sm text-text overflow-x-auto"><code><span class="text-[#F97316] select-none">❯ </span>sudo caddy run --config Caddyfile</code></pre>
				</div>
				<p class="text-xs sm:text-sm text-text-muted leading-relaxed">
					Caddy listens on <code class="font-mono text-xs text-text bg-surface-card px-1 py-0.5 rounded">127.0.0.1:80</code>. The site blocks use <code class="font-mono text-xs text-text bg-surface-card px-1 py-0.5 rounded">http://</code>, so no HTTPS certificates are involved.
				</p>
			</section>

			<!-- ## Test -->
			<section class="space-y-4">
				<h2 class="text-xl sm:text-2xl font-sans font-bold tracking-tight text-text">
					Test
				</h2>
				<div class="code-panel overflow-hidden">
					<div class="flex items-center justify-between px-4 py-2 border-b border-border/40 bg-surface-card/40 text-xs font-mono text-text-dim">
						<span class="flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-border"></span>
							<span>bash</span>
						</span>
						<button class="copy-cmd-btn text-text-dim hover:text-text text-[11px] font-mono transition-colors" data-cmd={"curl -i http://auth.test\ncurl -i http://api.test"}>
							Copy
						</button>
					</div>
					<pre class="p-4 font-mono text-xs sm:text-sm text-text overflow-x-auto space-y-1"><code><div><span class="text-[#F97316] select-none">❯ </span>curl -i http://auth.test</div><div><span class="text-[#F97316] select-none">❯ </span>curl -i http://api.test</div></code></pre>
				</div>
			</section>

			<!-- ## Check or revert -->
			<section class="space-y-4">
				<h2 class="text-xl sm:text-2xl font-sans font-bold tracking-tight text-text">
					Check or revert
				</h2>
				<div class="code-panel overflow-hidden">
					<div class="flex items-center justify-between px-4 py-2 border-b border-border/40 bg-surface-card/40 text-xs font-mono text-text-dim">
						<span class="flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-border"></span>
							<span>bash</span>
						</span>
						<button class="copy-cmd-btn text-text-dim hover:text-text text-[11px] font-mono transition-colors" data-cmd={"sudo bash loopback.sh --status\nsudo bash loopback.sh --uninstall"}>
							Copy
						</button>
					</div>
					<pre class="p-4 font-mono text-xs sm:text-sm text-text overflow-x-auto space-y-1"><code><div><span class="text-[#F97316] select-none">❯ </span>sudo bash loopback.sh --status</div><div><span class="text-[#F97316] select-none">❯ </span>sudo bash loopback.sh --uninstall</div></code></pre>
				</div>
				<p class="text-xs sm:text-sm text-text-muted leading-relaxed">
					<code class="font-mono text-xs text-[#F97316] bg-surface-card px-1 py-0.5 rounded">--uninstall</code> removes both aliases and the hosts block. It leaves the Caddyfile in place. Aliases don't survive a reboot. Run the setup again after restarting.
				</p>
			</section>

			<!-- ## Evidence -->
			<section class="space-y-4">
				<div class="flex items-center justify-between border-b border-border pb-3">
					<div>
						<h2 class="text-xl sm:text-2xl font-sans font-bold tracking-tight text-text">
							Evidence
						</h2>
						<p class="text-xs sm:text-sm text-text-muted mt-0.5">
							Live telemetry captured directly on the filming machine.
						</p>
					</div>
					<span class="font-mono text-xs text-text-dim flex items-center gap-1.5">
						<span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span>
						Verified Telemetry
					</span>
				</div>

				<!-- Telemetry Grid -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<!-- 1. The Collision -->
					<div class="code-panel p-4 space-y-2 font-mono text-xs">
						<div class="text-text-dim flex justify-between items-center text-[11px]">
							<span class="text-text-muted font-bold">1. COLLISION (SAME IP &middot; SAME PORT)</span>
							<span class="px-1.5 py-0.5 rounded bg-surface-card border border-[#F97316]/40 text-[#F97316] font-bold text-[10px]">EXIT 1</span>
						</div>
						<pre class="text-text/90 text-[11px] leading-relaxed overflow-x-auto"><code>$ ./auth --listen 127.0.0.1:8080
[ok] auth listening on 127.0.0.1:8080

$ ./api --listen 127.0.0.1:8080
<span class="text-[#F97316]">listen tcp 127.0.0.1:8080: bind: address already in use</span>
exit status 1</code></pre>
					</div>

					<!-- 2. The Fixed Output -->
					<div class="code-panel p-4 space-y-2 font-mono text-xs">
						<div class="text-text-dim flex justify-between items-center text-[11px]">
							<span class="text-text-muted font-bold">2. RESOLVED (DIFFERENT IP &middot; SAME PORT)</span>
							<span class="px-1.5 py-0.5 rounded bg-surface-card border border-[#10b981]/40 text-[#10b981] font-bold text-[10px]">LISTENING</span>
						</div>
						<pre class="text-text/90 text-[11px] leading-relaxed overflow-x-auto"><code>$ ./auth --listen 127.0.0.2:8080
[ok] auth listening on 127.0.0.2:8080

$ ./api --listen 127.0.0.3:8080
[ok] api listening on 127.0.0.3:8080</code></pre>
					</div>

					<!-- 3. Kernel Aliases -->
					<div class="code-panel p-4 space-y-2 font-mono text-xs">
						<div class="text-text-dim flex justify-between items-center text-[11px]">
							<span class="text-text-muted font-bold">3. KERNEL ALIASES (lo0)</span>
							<span class="text-[10px] text-text-dim">ifconfig lo0</span>
						</div>
						<pre class="text-text-muted text-[11px] leading-relaxed overflow-x-auto"><code>lo0: flags=8049&lt;UP,LOOPBACK,RUNNING,MULTICAST&gt; mtu 16384
    inet 127.0.0.1 netmask 0xff000000
    inet 127.0.0.2 netmask 0xff000000
    inet 127.0.0.3 netmask 0xff000000</code></pre>
					</div>

					<!-- 4. HTTP Responses -->
					<div class="code-panel p-4 space-y-2 font-mono text-xs">
						<div class="text-text-dim flex justify-between items-center text-[11px]">
							<span class="text-text-muted font-bold">4. CADDY PORT 80 ROUTING</span>
							<span class="px-1.5 py-0.5 rounded bg-surface-card border border-[#10b981]/40 text-[#10b981] font-bold text-[10px]">HTTP 200</span>
						</div>
						<pre class="text-text-muted text-[11px] leading-relaxed overflow-x-auto"><code>$ curl -i http://auth.test
HTTP/1.1 200 OK
Server: Caddy
&#123;"service":"auth"&#125;

$ curl -i http://api.test
HTTP/1.1 200 OK
Server: Caddy
&#123;"service":"api"&#125;</code></pre>
					</div>
				</div>
			</section>

			<!-- ## Tested on -->
			<section class="code-panel p-4 font-mono text-xs space-y-1">
				<span class="text-text-dim uppercase tracking-wider text-[10px]">TESTED ON</span>
				<div class="text-text-secondary text-xs sm:text-sm">
					macOS Sonoma (Darwin 24.1.0 arm64), filmed on November 16, 2026. Verified on Ubuntu 24.04 LTS (kernel 6.8).
				</div>
			</section>

			<!-- Footer Links -->
			<footer class="pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-text-dim">
				<div>Bare-Metal Logs by <a href="/" class="text-text underline hover:text-accent">Abhiuday</a> &bull; Bengaluru</div>
				<div class="flex items-center gap-4">
					<a href="/scripts" class="hover:text-accent transition-colors">All Scripts</a>
					<a href="https://instagram.com/baremetal.dev" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">Instagram</a>
					<a href="https://github.com/abhiudayg" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">GitHub</a>
				</div>
			</footer>
		</main>

		<Footer />

		<script>
			// Copy Script button functionality
			const copyScriptBtn = document.getElementById('copy-script-btn');
			const copyScriptText = document.getElementById('copy-script-text');

			if (copyScriptBtn && copyScriptText) {
				copyScriptBtn.addEventListener('click', async () => {
					try {
						const res = await fetch('/scripts/loopback.sh');
						const code = await res.text();
						await navigator.clipboard.writeText(code);
						copyScriptText.innerText = 'Copied!';
						setTimeout(() => {
							copyScriptText.innerText = 'Copy loopback.sh';
						}, 2000);
					} catch (e) {
						console.error('Failed to copy', e);
					}
				});
			}

			// Copy Command buttons
			document.querySelectorAll('.copy-cmd-btn').forEach((btn) => {
				btn.addEventListener('click', async (e) => {
					const target = e.currentTarget as HTMLButtonElement;
					const cmd = target.getAttribute('data-cmd') || '';
					try {
						await navigator.clipboard.writeText(cmd);
						const orig = target.innerText;
						target.innerText = 'Copied!';
						setTimeout(() => {
							target.innerText = orig;
						}, 1800);
					} catch (err) {
						console.error('Copy failed', err);
					}
				});
			});
		</script>
	</body>
</html>
