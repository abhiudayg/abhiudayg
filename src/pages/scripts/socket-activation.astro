---
import fs from 'node:fs';
import path from 'node:path';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import JsonLd from '../../components/JsonLd.astro';
import { AUTHOR_NAME } from '../../consts';
import { absoluteUrl, breadcrumbJsonLd, graphJsonLd } from '../../utils/seo';

const title = "Socket Activation: 0 MB While Idle — Bare-Metal Logs #05";
const description = "Your app holds memory even when nobody is using it. Two small systemd unit files let Linux hold the port instead — the program isn't running at all, the first request starts it, and it never dies. Measured: ~40 ms once, every request after is normal.";
const pageUrl = absoluteUrl('/scripts/socket-activation/', Astro.site);

const SOCKET_UNIT = `[Socket]
ListenStream=8080
[Install]
WantedBy=sockets.target`;

const SERVICE_UNIT = `[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/socket-demo.py`;

const STEPS = [
	{
		title: 'Install (writes the demo app and both unit files)',
		cmd: 'curl -fsSL https://abhiudayg.dev/scripts/socket-activation.sh | sudo bash',
		note: 'Linux only — needs systemd and python3. The two files are shown below; the script just writes them for you.',
	},
	{
		title: 'Prove the program is not running',
		cmd: 'systemctl is-active app.service',
		note: 'Prints "inactive". systemd alone is listening on :8080 — your program is using zero memory.',
	},
	{
		title: 'Knock on the port',
		cmd: 'time curl -s localhost:8080',
		note: 'systemd holds the connection, starts app.service, hands it the socket, and the request answers. First one costs ~40 ms once — it never fails.',
	},
	{
		title: 'Knock again',
		cmd: 'time curl -s localhost:8080',
		note: 'Under 1 ms. The service stays running for later requests until you stop it.',
	},
];

const schema = graphJsonLd(
	breadcrumbJsonLd([
		{ name: 'Home', url: absoluteUrl('/', Astro.site) },
		{ name: 'Scripts', url: absoluteUrl('/scripts/', Astro.site) },
		{ name: 'Socket Activation', url: pageUrl },
	]),
	{
		'@type': 'TechArticle',
		'@id': `${pageUrl}#article`,
		headline: title,
		description,
		url: pageUrl,
		inLanguage: 'en-US',
		author: { '@id': `${Astro.site || 'https://www.abhiudayg.dev'}/#person` },
		publisher: { '@id': `${Astro.site || 'https://www.abhiudayg.dev'}/#person` },
		keywords: ['socket activation', 'systemd socket', 'ListenStream', 'zero idle memory', 'bare metal', 'Linux', 'no Docker'],
		articleSection: 'DevOps & Systems Engineering',
	},
	{
		'@type': 'SoftwareSourceCode',
		'@id': `${pageUrl}#code`,
		name: 'socket-activation.sh',
		description: 'Installs a demo service and two systemd unit files (app.socket + app.service) for socket activation on port 8080',
		programmingLanguage: 'Bash',
		codeSampleType: 'full script',
	},
	{
		'@type': 'HowTo',
		'@id': `${pageUrl}#howto`,
		name: 'Activate a service on first request with systemd socket activation',
		description,
		url: pageUrl,
		step: STEPS.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.title, text: s.note })),
	}
);

const scriptPath = path.resolve('./public/scripts/socket-activation.sh');
const rawScript = fs.readFileSync(scriptPath, 'utf-8');
const lineCount = rawScript.trim().split('\n').length;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead
			title={`${title} — ${AUTHOR_NAME}`}
			description={description}
			canonicalPath="/scripts/socket-activation/"
			tags={['socket activation', 'systemd', 'ListenStream', 'zero idle memory', 'bare metal', 'linux', 'no docker', 'devops']}
		/>
		<JsonLd schema={schema} />
		<style>
			.code-panel {
				background: var(--surface-card);
				border: 1px solid var(--border);
				border-radius: 12px;
				transition: border-color 0.2s ease;
			}
			.code-panel:hover {
				border-color: var(--border-hover);
			}
		</style>
	</head>
	<body class="relative min-h-screen bg-bg text-text antialiased selection:bg-surface-card selection:text-accent">
		<div class="framer-grid-container" aria-hidden="true" id="framer-bg">
			<div class="framer-orb-1"></div>
			<div class="framer-orb-2"></div>
			<div class="framer-spotlight" id="framer-spotlight"></div>
			<div class="framer-grid-overlay"></div>
		</div>

		<Header />

		<main class="shell relative py-12 sm:py-16 md:py-20 space-y-12 max-w-3xl animate-fade-in">
			<header class="space-y-4 border-b border-border pb-8">
				<div class="flex flex-wrap items-center gap-2">
					<a href="/scripts" class="font-mono text-xs text-text-dim hover:text-accent transition-colors flex items-center gap-1">
						<span>←</span> All Scripts
					</a>
					<span class="text-text-dim">&bull;</span>
					<div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-surface-card border border-border font-mono text-xs text-text-muted">
						<span class="w-1.5 h-1.5 rounded-full bg-[#F97316]"></span>
						<span class="text-text font-medium">Bare-Metal Logs #05</span>
					</div>
				</div>

				<div class="space-y-2">
					<h1 class="text-3xl sm:text-4xl font-sans font-bold tracking-[-0.03em] text-text leading-[1.2]">
						Socket Activation: 0 MB While Idle
					</h1>
				</div>

				<p class="text-base sm:text-lg text-text-muted leading-relaxed">
					Your app holds memory even when nobody is using it. Two small unit files let Linux hold the port instead — the program isn't running at all, the first request starts it, and it never dies. Measured on a real box: <code class="font-mono text-xs text-[#F97316]">~40 ms</code> for the first request, <code class="font-mono text-xs text-[#F97316]">&lt;1 ms</code> for every one after.
				</p>

				<div class="rounded-lg border border-border bg-code-bg p-3 flex items-center justify-between gap-3 font-mono text-xs text-text-muted">
					<div class="flex items-center gap-2 overflow-x-auto">
						<span class="text-[#F97316] select-none font-bold">❯</span>
						<span class="text-text selection:bg-surface-card">curl -fsSL https://abhiudayg.dev/scripts/socket-activation.sh | sudo bash</span>
					</div>
					<button
						type="button"
						class="copy-cmd-btn shrink-0 px-2.5 py-1 rounded bg-surface-card border border-border text-text hover:border-border-hover cursor-pointer transition-colors"
						data-cmd="curl -fsSL https://abhiudayg.dev/scripts/socket-activation.sh | sudo bash"
					>
						Copy
					</button>
				</div>
			</header>

			<section class="space-y-4">
				<h2 class="font-mono text-xs uppercase tracking-wider text-text-dim">// The two files</h2>
				<p class="text-sm text-text-muted">That's the whole trick — no daemon, no Docker, no idle memory:</p>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<div class="code-panel overflow-hidden">
						<div class="flex items-center justify-between px-4 py-2 border-b border-border/40 bg-surface-card/40 text-xs font-mono text-text-dim">
							<span class="font-bold text-text">app.socket</span>
							<span class="text-[11px]">systemd owns :8080</span>
						</div>
						<pre class="p-4 font-mono text-xs text-text overflow-x-auto leading-relaxed"><code>{SOCKET_UNIT}</code></pre>
					</div>
					<div class="code-panel overflow-hidden">
						<div class="flex items-center justify-between px-4 py-2 border-b border-border/40 bg-surface-card/40 text-xs font-mono text-text-dim">
							<span class="font-bold text-text">app.service</span>
							<span class="text-[11px]">starts on first request</span>
						</div>
						<pre class="p-4 font-mono text-xs text-text overflow-x-auto leading-relaxed"><code>{SERVICE_UNIT}</code></pre>
					</div>
				</div>
				<p class="text-xs sm:text-sm text-text-muted leading-relaxed">
					<code class="font-mono text-xs text-text bg-surface-card px-1 py-0.5 rounded">app.socket</code> binds the port the moment it starts — while <code class="font-mono text-xs text-text bg-surface-card px-1 py-0.5 rounded">app.service</code> stays <code class="font-mono text-xs text-[#F97316]">inactive</code>. When a connection arrives, systemd queues it, starts the service, and hands it the listening socket (fd 3, <code class="font-mono text-xs text-text bg-surface-card px-1 py-0.5 rounded">LISTEN_FDS=1</code>). The first request waits, it doesn't die.
				</p>
			</section>

			<section class="space-y-6" aria-labelledby="steps-heading">
				<h2 id="steps-heading" class="font-mono text-xs uppercase tracking-wider text-text-dim">// Prove it</h2>
				<ol class="space-y-5">
					{STEPS.map((step, i) => (
						<li class="space-y-2">
							<h3 class="text-base font-semibold text-text">
								<span class="font-mono text-[#F97316] mr-2">{i + 1}.</span>{step.title}
							</h3>
							<div class="code-panel flex items-center justify-between gap-3 p-3 font-mono text-xs text-text-muted">
								<div class="flex items-center gap-2 overflow-x-auto">
									<span class="text-[#F97316] select-none font-bold">❯</span>
									<span class="text-text select-all">{step.cmd}</span>
								</div>
								<button
									type="button"
									class="copy-cmd-btn shrink-0 px-2.5 py-1 rounded bg-surface-card border border-border text-text hover:border-border-hover cursor-pointer transition-colors"
									data-cmd={step.cmd}
								>
									Copy
								</button>
							</div>
							<p class="text-sm text-text-dim">{step.note}</p>
						</li>
					))}
				</ol>
			</section>

			<section class="space-y-4" aria-labelledby="measured-heading">
				<h2 id="measured-heading" class="font-mono text-xs uppercase tracking-wider text-text-dim">// Measured</h2>
				<p class="text-sm text-text-muted">Same machine, same program — always-on vs socket-activated (OrbStack Debian, systemd 259):</p>
				<div class="code-panel overflow-hidden">
					<pre class="p-4 font-mono text-xs sm:text-sm text-text overflow-x-auto space-y-1"><code><div>always-on service, idle       <span class="text-[#F97316]">19–21 MB</span> resident</div><div>socket-activated, before knock <span class="text-[#10b981]">0 MB</span> — service inactive</div><div>first request                  <span class="text-[#F97316]">29–44 ms</span> total</div><div>every request after            <span class="text-[#10b981]">&lt;1 ms</span></div></code></pre>
				</div>
			</section>

			<section class="space-y-4">
				<details class="group code-panel overflow-hidden">
					<summary class="flex items-center justify-between px-4 py-2.5 cursor-pointer select-none bg-surface-card/60 text-xs font-mono text-text-dim hover:text-text transition-colors">
						<div class="flex items-center gap-2">
							<span class="group-open:rotate-90 transition-transform">▸</span>
							<span class="font-bold text-text">socket-activation.sh</span>
							<span>&bull; {lineCount} lines</span>
						</div>
						<a href="/scripts/socket-activation.sh" download="socket-activation.sh" class="text-[11px] hover:text-text">download .sh</a>
					</summary>
					<div class="p-4 border-t border-border/40 font-mono text-xs text-text-secondary overflow-x-auto max-h-[460px] overflow-y-auto leading-relaxed">
						<pre class="text-text/90"><code>{rawScript}</code></pre>
					</div>
				</details>
			</section>

			<section class="space-y-4" aria-labelledby="notes-heading">
				<h2 id="notes-heading" class="font-mono text-xs uppercase tracking-wider text-text-dim">// Before you use it</h2>
				<ul class="space-y-2 text-sm text-text-muted leading-relaxed list-disc pl-5">
					<li>Your own program must accept the listening socket on fd 3 when <code class="font-mono text-xs text-text">LISTEN_FDS=1</code> — the demo shows the pattern. Anything that ignores it just listens twice.</li>
					<li>The service stays running after the first request. To go back to 0 MB, stop it — or add <code class="font-mono text-xs text-text">StopWhenUnneeded</code>-style idle exits yourself.</li>
					<li>Requires a systemd distro (Debian, Ubuntu, Fedora, etc.) and root to install the units.</li>
					<li>Port 8080 must be free. Change <code class="font-mono text-xs text-text">ListenStream=</code> in app.socket for another port.</li>
				</ul>
			</section>
		</main>

		<Footer />

		<script>
			document.querySelectorAll<HTMLButtonElement>('.copy-cmd-btn').forEach((btn) => {
				btn.addEventListener('click', async () => {
					const cmd = btn.dataset.cmd ?? '';
					try {
						await navigator.clipboard.writeText(cmd);
						btn.textContent = 'Copied';
						setTimeout(() => (btn.textContent = 'Copy'), 1500);
					} catch {
						btn.textContent = 'Failed';
						setTimeout(() => (btn.textContent = 'Copy'), 1500);
					}
				});
			});
		</script>
	</body>
</html>
