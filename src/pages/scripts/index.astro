---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import JsonLd from '../../components/JsonLd.astro';
import { AUTHOR_NAME } from '../../consts';
import { absoluteUrl, breadcrumbJsonLd, graphJsonLd } from '../../utils/seo';

const title = "Bare-Metal Systems Scripts & Kernel Primitives";
const description = "Production-grade, zero-dependency bash scripts to eliminate cloud bloat, manage bare-metal processes, and optimize local networking.";

const schema = graphJsonLd(
	breadcrumbJsonLd([
		{ name: 'Home', url: absoluteUrl('/', Astro.site) },
		{ name: 'Scripts', url: absoluteUrl('/scripts/', Astro.site) },
	]),
);

const SCRIPTS = [
	{
		id: "loopback",
		title: "Loopback Subnet Engine (loopback.sh)",
		series: "The Bare-Metal Stack #02",
		status: "LIVE",
		badgeColor: "status-emerald",
		desc: "Binds the 16.7M RFC 1122 127.0.0.0/8 loopback subnet, maps clean .local domains in /etc/hosts, and configures Caddy on port 80/443 with 0 port collisions.",
		curlCmd: "curl -fsSL https://abhiudayg.dev/scripts/loopback.sh | sudo bash",
		href: "/scripts/loopback",
		tags: ["Networking", "RFC 1122", "Caddy", "Zero-Bloat"],
	},
	{
		id: "systemd-unit",
		title: "Native systemd Go/Rust Supervisor",
		series: "The Bare-Metal Stack #01",
		status: "RELEASED",
		badgeColor: "accent",
		desc: "Auto-generates hardened Linux systemd service units with automatic restart, journald streaming, and zero-downtime socket handoffs for static binaries.",
		curlCmd: "brew install abhiudayg/tap/anode",
		href: "https://github.com/abhiudayg/anode",
		tags: ["systemd", "Go", "Process Management", "18MB Footprint"],
	},
	{
		id: "cgroups-sandbox",
		title: "Linux cgroups v2 Memory Jail",
		series: "The Bare-Metal Stack #04",
		status: "COMING SOON",
		badgeColor: "text-dim",
		desc: "Hard limit local dev processes to strictly 128MB RAM and 20% CPU without installing Docker, containerd, or Kubernetes.",
		curlCmd: "Coming in Episode #04",
		href: "#",
		tags: ["cgroups v2", "Linux Kernel", "Memory Limits"],
	},
];
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead title={`${title} — ${AUTHOR_NAME}`} description={description} />
		<JsonLd schema={schema} />
	</head>
	<body class="relative min-h-screen bg-bg text-text antialiased selection:bg-surface-card selection:text-accent">
		<!-- Framer-Style Animated Background -->
		<div class="framer-grid-container" aria-hidden="true" id="framer-bg">
			<div class="framer-orb-1"></div>
			<div class="framer-orb-2"></div>
			<div class="framer-spotlight" id="framer-spotlight"></div>
			<div class="framer-grid-overlay"></div>
		</div>

		<Header />

		<main class="shell relative py-12 sm:py-16 md:py-20 space-y-12 max-w-4xl animate-fade-in">
			<!-- Header Banner -->
			<header class="space-y-4 border-b border-border pb-10">
				<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-card border border-border font-mono text-xs text-text-muted">
					<span class="w-1.5 h-1.5 rounded-full bg-status-emerald animate-pulse"></span>
					<span class="text-accent font-semibold">The Bare-Metal Stack</span>
					<span>&bull; Automation Scripts Directory</span>
				</div>
				<h1 class="text-3xl sm:text-5xl font-sans font-bold tracking-[-0.035em] text-text leading-[1.15]">
					Bare-Metal Systems Scripts
				</h1>
				<p class="text-base sm:text-lg text-text-muted leading-relaxed max-w-2xl">
					Single, zero-dependency, copy-pasteable bash scripts designed to eliminate cloud bloat, bypass heavy container daemons, and squeeze native performance out of your local machine.
				</p>
			</header>

			<!-- Scripts List -->
			<section class="space-y-6">
				{SCRIPTS.map((script) => (
					<div class="caveman-panel p-6 sm:p-7 bento-card-glow rounded-xl border border-border bg-surface-card space-y-4 transition-all hover:border-accent/40">
						<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-border/50 pb-3">
							<div class="space-y-1">
								<span class="font-mono text-xs text-accent uppercase tracking-wider">{script.series}</span>
								<h2 class="text-xl font-bold text-text">
									<a href={script.href} class="hover:text-accent transition-colors flex items-center gap-2">
										{script.title}
										<span class="text-sm">→</span>
									</a>
								</h2>
							</div>

							<span class={`font-mono text-xs px-2.5 py-1 rounded bg-surface-card border border-border text-${script.badgeColor} shrink-0`}>
								{script.status}
							</span>
						</div>

						<p class="text-sm text-text-muted leading-relaxed">
							{script.desc}
						</p>

						<!-- Command Box -->
						<div class="caveman-panel p-3 bg-bg border border-border/60 rounded-lg font-mono text-xs flex items-center justify-between gap-2 overflow-x-auto text-text">
							<div class="flex items-center gap-2">
								<span class="text-accent">❯</span>
								<span>{script.curlCmd}</span>
							</div>
							{script.status === "LIVE" && (
								<a href={script.href} class="text-accent hover:underline text-xs shrink-0">
									Inspect &amp; Evidence →
								</a>
							)}
						</div>

						<!-- Tags -->
						<div class="flex flex-wrap gap-2 pt-1 font-mono text-[11px] text-text-dim">
							{script.tags.map((t) => (
								<span class="px-2 py-0.5 rounded bg-surface-card border border-border/50">
									#{t}
								</span>
							))}
						</div>
					</div>
				))}
			</section>

			<!-- Footer Links -->
			<footer class="pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-text-dim">
				<div>The Bare-Metal Stack by <a href="/" class="text-text underline hover:text-accent">Abhiuday</a> &bull; Bengaluru</div>
				<div class="flex items-center gap-4">
					<a href="https://instagram.com/baremetal.dev" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">Instagram (@baremetal.dev)</a>
					<a href="https://github.com/abhiudayg" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">GitHub</a>
				</div>
			</footer>
		</main>

		<Footer />
	</body>
</html>
