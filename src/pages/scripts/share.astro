---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import JsonLd from '../../components/JsonLd.astro';
import { AUTHOR_NAME } from '../../consts';
import { absoluteUrl, breadcrumbJsonLd, graphJsonLd } from '../../utils/seo';

const title = "Share a Folder to Your Phone Over Wi-Fi — Bare-Metal Logs #04";
const description = "Send files from your laptop to your phone without uploading them anywhere. One command serves a folder on your Wi-Fi, and your phone opens it in the browser. No app, no cable, no cloud.";
const pageUrl = absoluteUrl('/scripts/share/', Astro.site);

const STEPS = [
	{
		title: 'Make a folder and put the files in it',
		cmd: 'mkdir ~/share',
		note: 'Copy the files you want on your phone into this folder.',
	},
	{
		title: 'Start sharing',
		cmd: 'python3 -m http.server 8000 --directory ~/share',
		note: 'Leave this running. It serves the folder on port 8000.',
	},
	{
		title: "Find your laptop's address",
		cmd: 'ipconfig getifaddr en0',
		note: 'On macOS. On Linux, use hostname -I instead.',
	},
	{
		title: 'Open it on your phone (same Wi-Fi)',
		cmd: 'http://<that address>:8000',
		note: 'Replace <that address> with the address from step 3. Tap a file to download it.',
	},
	{
		title: 'Check it is running',
		cmd: 'curl -I http://localhost:8000',
		note: 'You should see HTTP/1.0 200 OK.',
	},
	{
		title: 'Stop sharing',
		cmd: 'Control C',
		note: 'Press Control C in the terminal where step 2 is running.',
	},
];

const schema = graphJsonLd(
	breadcrumbJsonLd([
		{ name: 'Home', url: absoluteUrl('/', Astro.site) },
		{ name: 'Scripts', url: absoluteUrl('/scripts/', Astro.site) },
		{ name: 'Share a Folder to Your Phone', url: pageUrl },
	]),
	{
		'@type': 'HowTo',
		'@id': `${pageUrl}#howto`,
		name: 'Share a folder to your phone over Wi-Fi',
		description,
		url: pageUrl,
		step: STEPS.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.title, text: s.note })),
	},
);
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead
			title={`${title} — ${AUTHOR_NAME}`}
			description={description}
			canonicalPath="/scripts/share/"
			tags={['share files', 'python http server', 'local wifi', 'send files to phone', 'no cloud', 'bare metal', 'terminal']}
		/>
		<JsonLd schema={schema} />
		<style>
			.code-panel {
				background: var(--surface-card);
				border: 1px solid var(--border);
				border-radius: 12px;
				transition: border-color 0.2s ease;
			}
			.code-panel:hover {
				border-color: var(--border-hover);
			}
		</style>
	</head>
	<body class="relative min-h-screen bg-bg text-text antialiased selection:bg-surface-card selection:text-accent">
		<div class="framer-grid-container" aria-hidden="true" id="framer-bg">
			<div class="framer-orb-1"></div>
			<div class="framer-orb-2"></div>
			<div class="framer-spotlight" id="framer-spotlight"></div>
			<div class="framer-grid-overlay"></div>
		</div>

		<Header />

		<main class="shell relative py-12 sm:py-16 md:py-20 space-y-12 max-w-3xl animate-fade-in">
			<header class="space-y-4 border-b border-border pb-8">
				<div class="flex flex-wrap items-center gap-2">
					<a href="/scripts" class="font-mono text-xs text-text-dim hover:text-accent transition-colors flex items-center gap-1">
						<span>←</span> All Scripts
					</a>
					<span class="text-text-dim">&bull;</span>
					<div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-surface-card border border-border font-mono text-xs text-text-muted">
						<span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span>
						<span class="text-text font-medium">Bare-Metal Logs #04</span>
					</div>
				</div>

				<div class="space-y-2">
					<h1 class="text-3xl sm:text-4xl font-sans font-bold tracking-[-0.03em] text-text leading-[1.2]">
						Share a Folder to Your Phone Over Wi-Fi
					</h1>
				</div>

				<p class="text-base sm:text-lg text-text-muted leading-relaxed">
					Send files from your laptop to your phone without uploading them anywhere. One command serves a folder on your Wi-Fi, and your phone opens it in the browser. No app, no cable, no cloud.
				</p>
			</header>

			<section class="space-y-6" aria-labelledby="steps-heading">
				<h2 id="steps-heading" class="font-mono text-xs uppercase tracking-wider text-text-dim">// Steps</h2>

				<ol class="space-y-5">
					{STEPS.map((step, i) => (
						<li class="space-y-2">
							<h3 class="text-base font-semibold text-text">
								<span class="font-mono text-[#F97316] mr-2">{i + 1}.</span>{step.title}
							</h3>
							<div class="code-panel flex items-center justify-between gap-3 p-3 font-mono text-xs text-text-muted">
								<div class="flex items-center gap-2 overflow-x-auto">
									<span class="text-[#F97316] select-none font-bold">❯</span>
									<span class="text-text select-all">{step.cmd}</span>
								</div>
								<button
									type="button"
									class="copy-cmd-btn shrink-0 px-2.5 py-1 rounded bg-surface-card border border-border text-text hover:border-border-hover cursor-pointer transition-colors"
									data-cmd={step.cmd}
								>
									Copy
								</button>
							</div>
							<p class="text-sm text-text-dim">{step.note}</p>
						</li>
					))}
				</ol>
			</section>

			<section class="space-y-4" aria-labelledby="notes-heading">
				<h2 id="notes-heading" class="font-mono text-xs uppercase tracking-wider text-text-dim">// Before you use it</h2>
				<ul class="space-y-2 text-sm text-text-muted leading-relaxed list-disc pl-5">
					<li>There is no password and no encryption. Use it only on Wi-Fi you trust.</li>
					<li>Anyone on the same Wi-Fi who has the address can open the folder while the server runs.</li>
					<li>Guest networks often block devices from seeing each other, so the phone will not connect there.</li>
					<li>macOS may ask whether to allow incoming connections for Python. Allow it.</li>
					<li>Python 3 must be installed. On macOS, <code class="font-mono text-xs text-text">python3</code> may prompt you to install the developer tools the first time.</li>
				</ul>
			</section>
		</main>

		<Footer />

		<script>
			document.querySelectorAll<HTMLButtonElement>('.copy-cmd-btn').forEach((btn) => {
				btn.addEventListener('click', async () => {
					const cmd = btn.dataset.cmd ?? '';
					try {
						await navigator.clipboard.writeText(cmd);
						btn.textContent = 'Copied';
						setTimeout(() => (btn.textContent = 'Copy'), 1500);
					} catch {
						btn.textContent = 'Failed';
						setTimeout(() => (btn.textContent = 'Copy'), 1500);
					}
				});
			});
		</script>
	</body>
</html>
