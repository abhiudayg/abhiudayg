---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { AUTHOR_NAME, BLOG_SERIES, GITHUB_URL, INSTAGRAM_URL, LINKEDIN_URL, RSS_FEED_URL, SITE_DESCRIPTION, TWITTER_URL } from '../consts';
import { aboutPageJsonLd, absoluteUrl, breadcrumbJsonLd, graphJsonLd } from '../utils/seo';

const description = `About ${AUTHOR_NAME} — Systems & AI Engineer in Bengaluru. Building distributed financial ledgers by day; bare-metal Go, Rust runtimes, and autonomous verification engines by night.`;
const schema = graphJsonLd(
	aboutPageJsonLd(Astro.site),
	breadcrumbJsonLd([
		{ name: 'Home', url: absoluteUrl('/', Astro.site) },
		{ name: 'About', url: absoluteUrl('/about/', Astro.site) },
	]),
);
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead title={`About & Systems Manifesto — ${AUTHOR_NAME}`} description={description} />
		<JsonLd schema={schema} />
	</head>
	<body class="relative min-h-screen bg-bg text-text antialiased selection:bg-surface-card selection:text-accent">
		<!-- Framer-Style Animated Moving Gradient Grid Background -->
		<div class="framer-grid-container" aria-hidden="true" id="framer-bg">
			<div class="framer-orb-1"></div>
			<div class="framer-orb-2"></div>
			<div class="framer-spotlight" id="framer-spotlight"></div>
			<div class="framer-grid-overlay"></div>
		</div>

		<Header />

		<main class="shell relative py-12 sm:py-16 md:py-20 space-y-16 max-w-4xl animate-fade-in">
			<!-- Header / Title Banner -->
			<header class="space-y-4 border-b border-border pb-10">
				<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-card border border-border font-mono text-xs text-text-muted">
					<span class="w-1.5 h-1.5 rounded-full bg-status-emerald animate-pulse"></span>
					<span>Bengaluru, India &bull; Systems &amp; AI Engineer &bull; Open Source</span>
				</div>
				<h1 class="text-3xl sm:text-5xl font-sans font-semibold tracking-[-0.035em] text-text leading-[1.15]">
					About {AUTHOR_NAME}
				</h1>
				<p class="text-base sm:text-lg text-text-muted leading-relaxed max-w-3xl">
					Wrangling enterprise Java &amp; high-throughput distributed payment ledgers by day ☕. Hacking on bare-metal Go, Rust, and autonomous agent verification runtimes by night 🚀.
				</p>
			</header>

			<!-- 1. The Living Duality (Caveman Comparative Harness Matrix) -->
			<section class="space-y-6">
				<div class="flex items-center justify-between">
					<span class="font-mono text-xs uppercase tracking-wider text-text-dim">// ENGINEERING PARADIGMS</span>
					<span class="font-mono text-[11px] text-status-emerald">0ms Cloud Bloat</span>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
					<!-- By Day Card -->
					<div class="caveman-panel p-6 sm:p-7 bento-card-glow space-y-5">
						<div class="flex items-center justify-between border-b border-border pb-4">
							<div class="space-y-0.5">
								<span class="font-mono text-[11px] text-text-dim uppercase tracking-wider">08:30 &mdash; 18:00 IST</span>
								<h2 class="text-lg font-semibold text-text">By Day: Distributed Ledgers</h2>
							</div>
							<span class="px-2.5 py-1 rounded bg-surface-card border border-border font-mono text-xs text-text">☕ Zeta / BillDesk</span>
						</div>

						<p class="text-sm text-text-muted leading-relaxed">
							Architecting high-throughput distributed payment switches and banking ledger systems where network blinks mid-request are normal.
						</p>

						<div class="space-y-2.5 font-mono text-xs text-text-dim">
							<div class="flex justify-between border-b border-border/50 pb-1.5">
								<span>Core Invariant:</span>
								<span class="text-text font-medium text-right">Zero double-charges or phantom balances</span>
							</div>
							<div class="flex justify-between border-b border-border/50 pb-1.5">
								<span>Primary Stack:</span>
								<span class="text-text font-medium text-right">Java 21, Spring Boot, Kafka, Postgres</span>
							</div>
							<div class="flex justify-between">
								<span>Throughput Envelope:</span>
								<span class="text-status-emerald font-medium text-right">10,000+ tx/sec, 99.999% SLA</span>
							</div>
						</div>
					</div>

					<!-- By Night Card -->
					<div class="caveman-panel p-6 sm:p-7 bento-card-glow space-y-5 border-status-emerald/30">
						<div class="flex items-center justify-between border-b border-border pb-4">
							<div class="space-y-0.5">
								<span class="font-mono text-[11px] text-status-emerald uppercase tracking-wider">19:30 &mdash; 02:00 IST</span>
								<h2 class="text-lg font-semibold text-text">By Night: Bare-Metal Systems</h2>
							</div>
							<span class="px-2.5 py-1 rounded bg-status-emerald/10 border border-status-emerald/30 font-mono text-xs text-status-emerald">🚀 Open Source</span>
						</div>

						<p class="text-sm text-text-muted leading-relaxed">
							Writing low-latency developer infrastructure, Linux kernel orchestrators, and cryptographic verification hooks for coding agents.
						</p>

						<div class="space-y-2.5 font-mono text-xs text-text-dim">
							<div class="flex justify-between border-b border-border/50 pb-1.5">
								<span>Core Invariant:</span>
								<span class="text-text font-medium text-right">Cryptographic proofs over prompt drift</span>
							</div>
							<div class="flex justify-between border-b border-border/50 pb-1.5">
								<span>Primary Stack:</span>
								<span class="text-text font-medium text-right">Go (SSA), Rust (tokio), systemd, cgroups</span>
							</div>
							<div class="flex justify-between">
								<span>Cold Boot Time:</span>
								<span class="text-status-emerald font-medium text-right">~35ms boot, 0 Docker daemons</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- 2. The 6 Engineered Systems Grid -->
			<section class="space-y-6">
				<div class="flex items-center justify-between">
					<span class="font-mono text-xs uppercase tracking-wider text-text-dim">// ENGINEERED SYSTEMS &amp; RUNTIMES</span>
					<a href="/#systems" class="font-mono text-xs text-text-dim hover:text-text no-underline">View full matrix &rarr;</a>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
					{Object.entries(BLOG_SERIES).map(([slug, s]) => (
						<a href={`/blog/series/${slug}/`} class="caveman-panel p-5 bento-card-glow no-underline group block space-y-3">
							<div class="flex items-center justify-between font-mono text-xs">
								<span class="font-semibold text-text group-hover:text-status-emerald transition-colors">
									{s.title}
								</span>
								<span class="px-2 py-0.5 rounded-full bg-surface-card border border-border text-[10px] text-text-dim">
									{s.badge}
								</span>
							</div>
							<p class="text-xs text-text-muted line-clamp-3 leading-relaxed">
								{s.description}
							</p>
							<div class="pt-2 border-t border-border/50 flex items-center justify-between font-mono text-[11px] text-text-dim">
								<span>{s.tag}</span>
								<span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
							</div>
						</a>
					))}
				</div>
			</section>

			<!-- 3. The 4 Non-Negotiable Invariants -->
			<section class="space-y-6">
				<div class="flex items-center justify-between">
					<span class="font-mono text-xs uppercase tracking-wider text-text-dim">// CORE ARCHITECTURAL INVARIANTS</span>
					<span class="font-mono text-xs text-text-dim">Caveman Philosophy</span>
				</div>

				<div class="caveman-panel divide-y divide-border overflow-hidden">
					<div class="p-5 sm:p-6 space-y-1.5">
						<div class="flex items-center gap-2 font-mono text-xs text-status-emerald">
							<span>01</span>
							<h3 class="font-semibold text-text text-sm sm:text-base">Verification as a Hard Invariant</h3>
						</div>
						<p class="text-xs sm:text-sm text-text-muted leading-relaxed pl-6">
							Polite advice does not stop AI agent drift. Every claim, test runner exit code, and build must be bound to git tree SHAs via cryptographic receipts (<code class="font-mono text-[11px] px-1 py-0.5 rounded bg-code-bg border border-border">tekmor verify</code>). Zero hallucinated passes.
						</p>
					</div>

					<div class="p-5 sm:p-6 space-y-1.5">
						<div class="flex items-center gap-2 font-mono text-xs text-status-emerald">
							<span>02</span>
							<h3 class="font-semibold text-text text-sm sm:text-base">Token Budget Knapsacks over Prompt Dumping</h3>
						</div>
						<p class="text-xs sm:text-sm text-text-muted leading-relaxed pl-6">
							Dumping 10,000 tokens of rules dilutes model attention and bankrupts context. We serve high-signal, ~500-token byte-capped envelopes with strict TTL expiration dates on memory facts.
						</p>
					</div>

					<div class="p-5 sm:p-6 space-y-1.5">
						<div class="flex items-center gap-2 font-mono text-xs text-status-emerald">
							<span>03</span>
							<h3 class="font-semibold text-text text-sm sm:text-base">Bare-Metal Simplicity Over Hypervisor Shims</h3>
						</div>
						<p class="text-xs sm:text-sm text-text-muted leading-relaxed pl-6">
							Single compiled binaries with static links do not need 500MB Docker daemons or iptables bridges. Embrace Linux kernel primitives (<code class="font-mono text-[11px] px-1 py-0.5 rounded bg-code-bg border border-border">systemd</code>, <code class="font-mono text-[11px] px-1 py-0.5 rounded bg-code-bg border border-border">cgroups v2</code>, loopback routing) for sub-10ms cold starts (<code class="font-mono text-[11px] px-1 py-0.5 rounded bg-code-bg border border-border">anode</code>).
						</p>
					</div>

					<div class="p-5 sm:p-6 space-y-1.5">
						<div class="flex items-center gap-2 font-mono text-xs text-status-emerald">
							<span>04</span>
							<h3 class="font-semibold text-text text-sm sm:text-base">100% Zero-Tracker Web Ethos</h3>
						</div>
						<p class="text-xs sm:text-sm text-text-muted leading-relaxed pl-6">
							Zero client-side analytics trackers, zero surveillance pixels, zero paywalls. The entire catalog is syndicated transparently via full-text RSS and machine-readable index at <a href="/llms.txt" class="underline text-text hover:text-accent font-mono text-xs">/llms.txt</a>.
						</p>
					</div>
				</div>
			</section>

			<!-- 4. Channel Spotlight: @baremetal.dev & Direct Connect -->
			<section class="space-y-6">
				<div class="flex items-center justify-between">
					<span class="font-mono text-xs uppercase tracking-wider text-text-dim">// SYNDICATION &amp; SOCIALS</span>
					<span class="font-mono text-xs text-text-dim">📍 Bengaluru</span>
				</div>

				<div class="caveman-panel p-6 sm:p-8 bento-card-glow space-y-6">
					<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border pb-6">
						<div class="space-y-1.5">
							<div class="flex items-center gap-2">
								<span class="w-2 h-2 rounded-full bg-status-emerald animate-ping"></span>
								<h2 class="text-lg font-semibold text-text">@baremetal.dev &mdash; Systems Without Cloud Bloat</h2>
							</div>
							<p class="text-xs sm:text-sm text-text-muted font-sans">
								Excalidraw &bull; Terminals &bull; Bare Metal. Deep-dive explanations on Linux kernel internals, low-level networking, and distributed systems.
							</p>
						</div>

						<a
							class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-text text-bg hover:bg-white transition-colors font-mono text-xs font-semibold no-underline shrink-0"
							href={INSTAGRAM_URL}
							target="_blank"
							rel="noopener noreferrer"
						>
							<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
								<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
							</svg>
							<span>Follow @baremetal.dev &nearr;</span>
						</a>
					</div>

					<div class="flex flex-wrap items-center justify-between gap-4">
						<SocialLinks class="justify-start" />
						<a href={RSS_FEED_URL} class="font-mono text-xs text-text-muted hover:text-text no-underline flex items-center gap-1.5">
							<span class="w-1.5 h-1.5 rounded-full bg-status-emerald"></span>
							<span>Full-text RSS feed &rarr;</span>
						</a>
					</div>
				</div>
			</section>
		</main>

		<Footer />

		<script is:inline>
			function initSpotlight() {
				const bg = document.getElementById('framer-bg');
				if (!bg) return;
				document.addEventListener('pointermove', (e) => {
					bg.style.setProperty('--mouse-x', `${e.clientX}px`);
					bg.style.setProperty('--mouse-y', `${e.clientY}px`);
				});
			}
			initSpotlight();
			document.addEventListener('astro:page-load', initSpotlight);
		</script>
	</body>
</html>
