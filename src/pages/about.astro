---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { AUTHOR_NAME, GITHUB_URL, SITE_DESCRIPTION } from '../consts';
import { aboutPageJsonLd, absoluteUrl, breadcrumbJsonLd, graphJsonLd } from '../utils/seo';

const description = `About ${AUTHOR_NAME} — Systems & AI Engineer, builder of autonomous agent runtimes, real-time distributed data pipelines, and developer infrastructure.`;
const schema = graphJsonLd(
	aboutPageJsonLd(Astro.site),
	breadcrumbJsonLd([
		{ name: 'Home', url: absoluteUrl('/', Astro.site) },
		{ name: 'About', url: absoluteUrl('/about/', Astro.site) },
	]),
);
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<BaseHead title={`About & Engineering Manifesto — ${AUTHOR_NAME}`} description={description} />
		<JsonLd schema={schema} />
	</head>
	<body class="relative min-h-screen bg-bg text-text antialiased selection:bg-surface-card selection:text-accent">
		<!-- Subdued ambient dark radial halo -->
		<div
			class="pointer-events-none fixed top-0 left-1/2 -z-10 h-[500px] w-[950px] -translate-x-1/2 rounded-full ambient-glow blur-[120px]"
			aria-hidden="true"
		></div>

		<Header />
		<main class="layout-read py-12 md:py-16">
			<article>
				<header class="mb-10 border-b border-border pb-8">
					<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-card border border-border font-mono text-xs text-text-muted mb-4">
						<span class="w-1.5 h-1.5 rounded-full bg-status-emerald"></span>
						<span>Engineer &bull; Builder &bull; Open Source</span>
					</div>
					<h1 class="text-3xl sm:text-4xl md:text-5xl font-sans font-semibold tracking-tight text-text">
						About {AUTHOR_NAME}
					</h1>
					<p class="mt-3 text-base sm:text-lg text-text-muted leading-relaxed">
						{SITE_DESCRIPTION}
					</p>
				</header>

				<div class="prose-content space-y-6">
					<p>
						hey, i'm <strong>{AUTHOR_NAME}</strong> &mdash; a software engineer based in bengaluru, india 🤍. i started this site as a cozy, open engineering lab: sharing raw discoveries, fun weekend hacks, production post-mortems, and things that make programming joyful.
					</p>

					<h2 class="text-2xl font-semibold text-text pt-4">the living duality ☕🚀</h2>
					<p>
						my engineering life lives in a fun little duality:
					</p>
					<ul class="list-disc pl-5 space-y-2 text-text-muted">
						<li>
							<strong class="text-text">by day:</strong> i'm an SDE 2 at <strong>Zeta</strong> (and previously built high-throughput UPI payment switches at <strong>BillDesk</strong>). wrangling enterprise <strong>Java, Spring Boot</strong>, PostgreSQL, Kafka, and distributed ledger systems where the golden rule is "never lose money or double-charge someone even if the network blinks mid-request" ☕.
						</li>
						<li>
							<strong class="text-text">by night:</strong> hacking in <strong>Go, Rust, and Linux kernel primitives</strong> (`cgroups v2`, `systemd`, dynamic loopback networking). building tools that compile in milliseconds, drink almost zero RAM, and make shipping feel like magic ✨.
						</li>
					</ul>

					<h2 class="text-2xl font-semibold text-text pt-4">what i'm building &amp; exploring</h2>
					<ul class="list-disc pl-5 space-y-2 text-text-muted">
						<li>
							<strong class="text-text">Bare-Metal Systems &amp; Orchestration:</strong> <a href="/blog/series/anode/">anode</a> &mdash; a proof-of-topology orchestrator for Go that deduces infrastructure from your raw source code using Go SSA analysis, booting your apps directly on Linux systemd in under 8ms with zero Docker daemons and zero YAML drift 🚀.
						</li>
						<li>
							<strong class="text-text">Autonomous Agent Runtimes:</strong> <a href="/blog/series/agent-brain/">agent-brain</a> &mdash; a local-first cognitive governor and verification ledger that keeps AI coding agents honest, grounded in real test receipts, and strictly under token budgets.
						</li>
						<li>
							<strong class="text-text">Sandboxing &amp; Native Utilities:</strong> <a href="/blog/series/agentrun/">agentrun</a> for container worktree isolation, <a href="/blog/series/harbor/">harbor</a> for agent-native browsing, <a href="/blog/series/dustmap/">dustmap</a> for sub-12ms macOS disk visualization in Rust &amp; Tauri, and <a href="/blog/series/shipnote/">shipnote</a> for commit-grounded technical drafting.
						</li>
					</ul>

					<h2 class="text-2xl font-semibold text-text pt-4">the zero-tracker ethos</h2>
					<p>
						this site is built with pure web standards: zero client-side surveillance, zero marketing tracking pixels, and zero paywalls. everything is syndicated transparently via <a href="/rss.xml">full-text RSS</a>. hope you enjoy poking around 🤍!
					</p>

					<h2 class="text-2xl font-semibold text-text pt-4">connect &amp; say hi</h2>
					<p>
						i share open source code on GitHub, post daily technical thoughts on X, and write longer dispatches here. let me know your thoughts anytime:
					</p>
					<div class="pt-2">
						<SocialLinks class="justify-start" />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
