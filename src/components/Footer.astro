---
import { AUTHOR_NAME, BLOG_SERIES, GITHUB_URL, REPO_URL, RSS_FEED_URL } from '../consts';
import SiteLogo from './SiteLogo.astro';

const today = new Date();
---

<footer class="w-full border-t border-border bg-bg pt-14 pb-16 text-text-muted">
	<div class="shell">
		<div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-12 pb-12 border-b border-border">
			<!-- Col 1: Brand & Ethos -->
			<div class="space-y-4 md:col-span-5">
				<a class="inline-flex items-center no-underline text-inherit transition hover:opacity-90" href="/" aria-label="Abhiuday home">
					<SiteLogo size={24} />
				</a>
				<p class="text-sm leading-relaxed text-text-muted max-w-sm font-sans">
					Architecting autonomous agent runtimes, real-time distributed data pipelines, and low-latency systems infrastructure.
				</p>
				<div class="flex items-center gap-2 font-mono text-xs text-text-dim">
					<span class="w-1.5 h-1.5 rounded-full bg-status-emerald"></span>
					<span>All systems operational &bull; Zero telemetry tracking</span>
				</div>
			</div>

			<!-- Col 2: Navigation -->
			<div class="space-y-3 md:col-span-3">
				<h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-text">Navigation</h3>
				<ul class="m-0 list-none space-y-2 p-0 text-xs font-mono">
					<li><a class="text-text-muted no-underline hover:text-text transition-colors" href="/">Home</a></li>
					<li><a class="text-text-muted no-underline hover:text-text transition-colors" href="/blog">Essays &amp; Archive</a></li>
					<li><a class="text-text-muted no-underline hover:text-text transition-colors" href="/#systems">Systems &amp; Runtimes</a></li>
					<li><a class="text-text-muted no-underline hover:text-text transition-colors" href="/#series">Deep Series</a></li>
					<li><a class="text-text-muted no-underline hover:text-text transition-colors" href="/about">About &amp; Manifesto</a></li>
					<li><a class="text-text-muted no-underline hover:text-text transition-colors" href="/subscribe">RSS Syndication</a></li>
				</ul>
			</div>

			<!-- Col 3: Series Deep Dives & Feeds -->
			<div class="space-y-3 md:col-span-4">
				<h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-text">Architecture Tracks</h3>
				<ul class="m-0 list-none space-y-2 p-0 text-xs font-mono">
					{Object.entries(BLOG_SERIES).map(([slug, s]) => (
						<li>
							<a class="text-text-muted no-underline hover:text-text transition-colors flex items-center justify-between" href={`/blog/series/${slug}/`}>
								<span>#{s.title}</span>
								<span class="text-text-dim text-[11px]">{s.badge}</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</div>

		<!-- Bottom Bar -->
		<div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 font-mono text-xs text-text-dim">
			<p class="m-0">
				&copy; {today.getFullYear()} {AUTHOR_NAME}. Built with zero trackers. Code under MIT.
			</p>
			<div class="flex items-center gap-4">
				<a class="text-text-dim hover:text-text transition-colors no-underline" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
				<span>&bull;</span>
				<a class="text-text-dim hover:text-text transition-colors no-underline" href={RSS_FEED_URL} target="_blank">RSS XML</a>
				<span>&bull;</span>
				<a class="text-text-dim hover:text-text transition-colors no-underline" href={REPO_URL} target="_blank" rel="noopener noreferrer">Source</a>
			</div>
		</div>
	</div>
</footer>
