---
import { GITHUB_URL, SITE_TITLE } from '../consts';
import CommandPalette from './CommandPalette.astro';
import HeaderLink from './HeaderLink.astro';
import SiteLogo from './SiteLogo.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-50 w-full border-b border-border bg-[var(--header-bg)] backdrop-blur-md">
	<div class="shell flex h-14 items-center justify-between gap-3 py-0">
		<div class="flex items-center gap-3 sm:gap-4">
			<a class="inline-flex items-center no-underline text-inherit transition hover:opacity-90" href="/" aria-label={`${SITE_TITLE} home`}>
				<SiteLogo />
			</a>
			<!-- Live Telemetry Status Pill -->
			<div class="hidden sm:inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-surface-card border border-border font-mono text-[11px]">
				<span class="w-1.5 h-1.5 rounded-full bg-status-emerald animate-pulse"></span>
				<span class="text-text-muted">Building Autonomous Systems</span>
			</div>
		</div>

		<!-- Center Navigation Links (Desktop) -->
		<nav class="hidden md:flex items-center gap-6 font-mono text-xs">
			<HeaderLink href="/blog">Essays</HeaderLink>
			<HeaderLink href="/#systems">Systems</HeaderLink>
			<HeaderLink href="/#series">Series</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/subscribe">RSS</HeaderLink>
		</nav>

		<!-- Right Side Action Cluster -->
		<div class="flex items-center gap-2 sm:gap-2.5">
			<!-- Quick ⌘K Search trigger -->
			<button
				type="button"
				id="header-search-btn"
				class="inline-flex items-center gap-1.5 sm:gap-2 px-2 sm:px-2.5 py-1 rounded-lg bg-surface-card border border-border text-text-dim hover:text-text hover:border-border-hover transition-colors font-mono text-xs cursor-pointer"
				onclick="window.dispatchEvent(new CustomEvent('open-cmdk')); document.dispatchEvent(new CustomEvent('open-cmdk'));"
				aria-label="Open search palette"
			>
				<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
				</svg>
				<span class="hidden sm:inline">Search</span>
				<kbd class="px-1.5 py-0.2 rounded bg-bg-subtle border border-border text-[10px] text-text-muted">⌘K</kbd>
			</button>

			<a
				class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-surface-card border border-border text-text-muted hover:text-text hover:border-border-hover transition-colors font-mono text-xs no-underline"
				href={GITHUB_URL}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="GitHub profile"
			>
				<svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
					<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
				</svg>
				<span class="hidden md:inline">GitHub</span>
			</a>

			<div class="h-4 w-px bg-border hidden sm:block"></div>
			<ThemeToggle />

			<!-- Mobile Menu Toggle Button -->
			<button
				type="button"
				id="mobile-menu-btn"
				class="inline-flex md:hidden items-center justify-center p-1.5 rounded-lg border border-border bg-surface-card text-text-muted hover:text-text cursor-pointer"
				aria-label="Toggle navigation menu"
				aria-expanded="false"
			>
				<svg id="menu-icon-bars" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
				<svg id="menu-icon-close" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>
	</div>

	<!-- Mobile Dropdown Menu -->
	<div id="mobile-nav" class="hidden md:hidden border-t border-border bg-bg-elevated/95 px-5 py-4 space-y-3 font-mono text-sm backdrop-blur-md">
		<div class="flex items-center gap-2 py-1 text-xs text-text-muted border-b border-border pb-2">
			<span class="w-1.5 h-1.5 rounded-full bg-status-emerald animate-pulse"></span>
			<span>Building Autonomous Systems</span>
		</div>
		<div class="flex flex-col space-y-2">
			<a class="text-text-muted hover:text-text py-1 no-underline transition-colors" href="/blog">Essays &amp; Archive</a>
			<a class="text-text-muted hover:text-text py-1 no-underline transition-colors" href="/#systems">Systems &amp; Runtimes</a>
			<a class="text-text-muted hover:text-text py-1 no-underline transition-colors" href="/#series">Deep Series</a>
			<a class="text-text-muted hover:text-text py-1 no-underline transition-colors" href="/about">About &amp; Manifesto</a>
			<a class="text-text-muted hover:text-text py-1 no-underline transition-colors" href="/subscribe">RSS Syndication</a>
			<a class="text-text-muted hover:text-text py-1 no-underline transition-colors" href={GITHUB_URL} target="_blank">GitHub &nearr;</a>
		</div>
	</div>
</header>

<!-- Universal Command Palette Modal (Outside header to avoid stacking context & backdrop-filter trapping) -->
<CommandPalette />

<script is:inline>
	(function() {
		const searchBtn = document.getElementById('header-search-btn');
		if (searchBtn) {
			searchBtn.addEventListener('click', (e) => {
				e.preventDefault();
				window.dispatchEvent(new CustomEvent('open-cmdk'));
				document.dispatchEvent(new CustomEvent('open-cmdk'));
			});
		}

		const btn = document.getElementById('mobile-menu-btn');
		const nav = document.getElementById('mobile-nav');
		const bars = document.getElementById('menu-icon-bars');
		const close = document.getElementById('menu-icon-close');

		if (btn && nav && bars && close) {
			btn.addEventListener('click', () => {
				const isOpen = !nav.classList.contains('hidden');
				if (isOpen) {
					nav.classList.add('hidden');
					bars.classList.remove('hidden');
					close.classList.add('hidden');
					btn.setAttribute('aria-expanded', 'false');
				} else {
					nav.classList.remove('hidden');
					bars.classList.add('hidden');
					close.classList.remove('hidden');
					btn.setAttribute('aria-expanded', 'true');
				}
			});

			nav.querySelectorAll('a').forEach(link => {
				link.addEventListener('click', () => {
					nav.classList.add('hidden');
					bars.classList.remove('hidden');
					close.classList.add('hidden');
					btn.setAttribute('aria-expanded', 'false');
				});
			});
		}
	})();
</script>
